# MeeTap Configuration

# ── AWS ───────────────────────────────────────────────────────
# Region (affects S3, Transcribe, Bedrock)
region = us-east-1

# ── AI / Meeting Notes ────────────────────────────────────────
# Backend for meeting notes generation (bedrock | claude-code)
ai_backend = bedrock
# Bedrock model (only used when ai_backend = bedrock)
model = global.anthropic.claude-sonnet-5

# ── Transcription ─────────────────────────────────────────────
# Languages (space-separated, priority order, AWS Transcribe codes)
# Full list: https://docs.aws.amazon.com/transcribe/latest/dg/supported-languages.html
transcribe_languages = en-US zh-CN ja-JP
# Max speaker labels for speaker diarization (2-10)
max_speakers = 10
# Enable multi-language detection within a single session (true/false)
multi_language = false

# ── Recording ─────────────────────────────────────────────────
# Output directory
recording_dir = ~/Record
# Audio bitrate (64k=small file, 128k=balanced, 256k=high quality). With the mic on, the two channels
# share it while recording (128k = 64k per channel, plenty for speech; 64k leaves 32k per channel and
# sounds muffled, so use 96k or more), and the final mono file is encoded at this rate again.
audio_bitrate = 128k
# Keep the local audio file after transcription (true=keep, false=delete once the transcript is saved)
audio_persist = true
# Meeting-room echo check, for recordings made with the mic on. If a meeting room device (Teams Room
# and the like) is in the same call, the computer audio repeats the room voices 1-2 s after the mic heard
# them. When that is found, meetap keeps only the computer audio (as if -m had been on) in the 30 s blocks
# where the mic speech is confirmed to be in the computer audio; other blocks mix both channels. Anyone
# the room device does not pick up is then not in the recording.
# on (default) / off = always mix both channels, as before.
echo_check = on
# When the echo check drops the mic, also keep the original two-channel recording in .meetap/ so the
# decision can be undone: set echo_check = off and run meetap again on that meeting.
# Costs about 58 MB per hour at 128k. Default false: the session holds one mono recording, as before.
keep_stereo_original = false
# Audio is always captured with Process Tap (macOS 14.4+); there is no capture setting.
# Silent-recording alert: if an app is playing sound but the capture is all zeros,
# meetap shows a notification within 30 s naming that app as "Name (bundle ID)",
# e.g. "Google Chrome (com.google.Chrome.helper)". Apps listed here don't
# count as "playing" (some keep an audio stream open while staying silent, e.g. the
# Amazon WorkSpaces client). If you get the alert while nothing was actually playing,
# add the part in parentheses (the bundle ID) here; for command-line programs, which
# have no parentheses, add the program name. Comma-separated.
zero_alert_ignore = com.amazon.workspaces

# ── Calendar ──────────────────────────────────────────────────
# After a recording stops, collect the meetings that overlap it from the macOS Calendar.
# After transcription, the meeting closest in start/end time is checked against the
# content by one extra call to the same AI backend as the notes (several meetings at exactly
# the same time: picked by content; content clearly unrelated: calendar not used). The
# picked meeting (title, organizer, attendees, agenda) goes into materials/calendar.md for
# the notes. Which meeting was picked and why is shown in log/meetap.log, `meetap <folder>`
# and the "notes ready" notification -- not in the notes, which get forwarded to others.
# Join links, meeting IDs, passwords and dial-in numbers are removed; the model only sees
# the first 500 characters of the agenda and the first 20 attendees. Requires calendar
# access granted once via `meetap setup` (per terminal app); never prompts otherwise.
# on | off  (off = never touch the calendar, no extra model call)
calendar = on

# ── Auto-stop ─────────────────────────────────────────────────
# Recording runs until you run `meetap stop`. To auto-stop after a fixed
# duration, pass a time limit (minutes) on start: `meetap start -d 60`.
# (Silence-based auto-stop was removed — meeting pauses shouldn't end a recording.)

# ── Display ───────────────────────────────────────────────────
# CLI display language (en-US | zh-CN)
# Only affects terminal output, notifications, and help text.
# Meeting notes are always generated in Chinese regardless of this setting;
# transcripts remain in the meeting's original language.
language = zh-CN
# Audio visualizer style: dot | bar | spectrum (color bars) | block
visualizer = dot

# ── Email (optional) ──────────────────────────────────────────
# Recipients for meeting notes (comma-separated, leave empty to disable)
# email = alice@example.com, bob@example.com
# SES verified sender address (required if email is set)
# email_sender = meetap@example.com

# ── End of MeeTap configuration ───────────────────────────────
