# 清洗标题为合法文件名片段：白名单只保留 中文/字母/数字/-/_，其余（含 / : | 空格、
# emoji、控制字符等）一律转 -；连续 - 合并；去首尾 -；按「字符」截断到 20。
# 用 perl -CS 在 UTF-8 字符层面处理，中文算 1 个字符，绝不会截出半个多字节字符。
# 清洗后为空时兜底返回 meeting。
sanitize_title() {
    local raw="$1" cleaned
    cleaned=$(printf '%s' "$raw" | perl -CS -pe '
        s/[^\p{Han}A-Za-z0-9_-]/-/g;   # 白名单外全部替换为 -
        s/-+/-/g;                       # 连续 - 合并
        s/^-+|-+$//g;                   # 去首尾 -
        $_ = substr($_, 0, 20);         # 按字符截断（-CS 下已解码为字符）
        s/-+$//;                        # 截断后可能重新露出尾部 -
    ')
    [[ -z "$cleaned" ]] && cleaned="meeting"
    printf '%s' "$cleaned"
}

# 纪要智能命名：把 meeting-notes.md **重命名**为「YYYY-MM-DD_HHMM_主题.md」
# （mv，不留固定名文件；最终产物只有 <智能命名>.md 与配套 .html）。
# 主题只用 meeting-notes.md 首行 <!-- meetap-title: XXX --> 元数据（Claude 生成），
# 拿不到则兜底 meeting；目录名（含用户 start 时给的会议名）只提供日期时间前缀。
# 标题注释行只要存在就从文件里删掉（它只是元数据，不该进正文/邮件）。
# 最终文件路径写到 stdout 供调用方接住；提示消息走 stderr 避免污染路径输出。
# 任何失败都回退输出原路径，保证调用方始终拿到一个存在的文件。
smart_name_notes() {
    local OUTPUT="$1"
    local SESSION_DIR="$2"
    local SESSION_NAME first_line title="" claude_title=""
    SESSION_NAME=$(basename "$SESSION_DIR")

    # 解析首行元数据；匹配到就删除该注释行（写临时文件后覆盖，避免读写同一文件）
    IFS= read -r first_line < "$OUTPUT" || true
    if [[ "$first_line" == "<!-- meetap-title:"* && "$first_line" == *"-->"* ]]; then
        claude_title="${first_line#<!-- meetap-title:}"
        claude_title="${claude_title%%-->*}"
        # 去首尾空白
        claude_title="${claude_title#"${claude_title%%[![:space:]]*}"}"
        claude_title="${claude_title%"${claude_title##*[![:space:]]}"}"
        local tmp
        tmp=$(mktemp "$SESSION_DIR/.notes.XXXXXX") || { printf '%s' "$OUTPUT"; return 0; }
        tail -n +2 "$OUTPUT" > "$tmp" && mv "$tmp" "$OUTPUT" || { rm -f "$tmp"; printf '%s' "$OUTPUT"; return 0; }
    fi

    # 日期时间前缀从 SESSION_DIR 目录名解析（与 build_prompt 的分支对应）：
    # 标准 20250715_1430[_会议名] → 2025-07-15_1430；非标准格式直接用目录名原样做前缀。
    local prefix
    if [[ "$SESSION_NAME" =~ ^([0-9]{4})([0-9]{2})([0-9]{2})_([0-9]{4})(_(.+))?$ ]]; then
        prefix="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]}_${BASH_REMATCH[4]}"
    else
        prefix="$SESSION_NAME"
    fi

    title=$(sanitize_title "$claude_title")

    # 防碰撞：已存在则追加 _2、_3…，绝不静默覆盖
    local target="$SESSION_DIR/${prefix}_${title}.md"
    if [[ -e "$target" ]]; then
        local n=2
        while [[ -e "$SESSION_DIR/${prefix}_${title}_${n}.md" ]]; do ((n++)); done
        target="$SESSION_DIR/${prefix}_${title}_${n}.md"
    fi

    # 末尾补两个空行：Typora 类编辑器打开时光标落在文件末尾，
    # 若末行是落款，其所在行会显示为 Markdown 源码；空行让光标落在空白处
    printf '\n\n' >> "$OUTPUT"
    mv "$OUTPUT" "$target" || { printf '%s' "$OUTPUT"; return 0; }
    echo "[$(date '+%H:%M:%S')] $(_tn NOTES_NAMED "$(basename "$target")")" >&2
    printf '%s' "$target"
}

summarize_transcript() {
    local SESSION_DIR="$1"
    local LOG_DIR="$SESSION_DIR/log"
    local TRANSCRIPT="$LOG_DIR/transcript.txt"
    local OUTPUT="$SESSION_DIR/meeting-notes.md"
    local PROMPT_FILE="$LOG_DIR/.prompt.tmp"

    if [[ ! -f "$TRANSCRIPT" ]]; then
        echo "[$(date '+%H:%M:%S')] $(_tn ERR_TRANSCRIPT_MISSING)"
        return 1
    fi

    echo "[$(date '+%H:%M:%S')] $(_tn GENERATING_NOTES "$CFG_AI_BACKEND")"

    # build_prompt 失败（模板缺失/损坏）时中止：删掉已被截断的空 prompt 文件，
    # 避免把空 prompt 发给 AI 后端浪费一次调用
    if ! build_prompt "$SESSION_DIR" > "$PROMPT_FILE"; then
        rm -f "$PROMPT_FILE"
        return 1
    fi

    case "$CFG_AI_BACKEND" in
        claude-code)
            summarize_via_claude_code "$PROMPT_FILE" "$OUTPUT"
            ;;
        bedrock|*)
            if [[ ! -x "$VENV_PYTHON" ]]; then
                echo "[$(date '+%H:%M:%S')] $(_tn ERR_VENV_MISSING "$VENV_PYTHON")"
                rm -f "$PROMPT_FILE"
                return 1
            fi
            summarize_via_bedrock "$PROMPT_FILE" "$OUTPUT"
            ;;
    esac

    rm -f "$PROMPT_FILE"

    if [[ -f "$OUTPUT" ]]; then
        # 规范化末尾空行：保证签名 footer 后有空行，编辑器打开即渲染而非显示源码。
        local NB_PY="$VENV_PYTHON"; [[ -x "$NB_PY" ]] || NB_PY="$(command -v python3)"
        [[ -n "$NB_PY" ]] && _normalize_trailing_blank "$NB_PY" "$OUTPUT"
        # smart_name_notes 把 meeting-notes.md 重命名为智能名,返回最终路径
        local FINAL_OUTPUT
        FINAL_OUTPUT=$(smart_name_notes "$OUTPUT" "$SESSION_DIR")
        echo "[$(date '+%H:%M:%S')] $(_tn NOTES_DONE "$FINAL_OUTPUT")"
        osascript -e "display notification \"$(_tn NOTIFY_NOTES_DONE)\" with title \"MeeTap\"" 2>/dev/null
        send_meeting_notes "$FINAL_OUTPUT" "$SESSION_DIR"
    else
        echo "[$(date '+%H:%M:%S')] $(_tn NOTES_FAILED)"
        osascript -e "display notification \"$(_tn NOTIFY_NOTES_FAILED)\" with title \"MeeTap\"" 2>/dev/null
    fi
}

# 会话文件夹名：20YYMMDD_HHMM，后面可接 _会议名（start 生成的格式）
SESSION_NAME_RE='^20[0-9]{6}_[0-9]{4}(_.*)?$'

# recording_dir 第一层最新一场（按目录名排序，命名以时间戳开头天然有序）。
# 只认会话名：用户手工按月聚合的 2026-10 这类文件夹也以 20 开头，不能算进候选。
_latest_session_dir() {
    local d latest=""
    while IFS= read -r d; do
        [[ "${d##*/}" =~ $SESSION_NAME_RE ]] && latest="$d"
    done < <(find "$RECORDING_DIR" -mindepth 1 -maxdepth 1 -type d -name "20*" | sort)
    printf '%s' "$latest"
}

# 找会话目录（again、mark、贴标签、显示信息共用）。
# resolve_session [目标] [strict]：目标为空 → recording_dir 第一层最新一场；
# 目标是已存在的目录（绝对路径或相对当前目录）→ 用它；否则在 recording_dir 下按名字找
# （也可以是 2026-10/20261008_1046 这样的相对路径）。
# strict：目录名必须是会话名，否则返回 3——meetap .、meetap src 这类真实目录不能当成会话。
# 找到：路径写到 stdout，返回 0；找不到返回 1；recording_dir 下一场会都没有返回 2。
# 报错文案由调用方各自打印（返回码区分情况），这里不输出提示。
resolve_session() {
    local target="${1:-}" strict="${2:-}" dir
    if [[ -z "$target" ]]; then
        dir=$(_latest_session_dir)
        [[ -n "$dir" ]] || return 2
    elif [[ -d "$target" ]]; then
        dir="$(cd -- "$target" && pwd)" || return 1
    elif [[ -d "$RECORDING_DIR/$target" ]]; then
        dir="$RECORDING_DIR/$target"
    else
        return 1
    fi
    if [[ "$strict" == strict ]]; then
        dir="$(cd -- "$dir" && pwd)" || return 1   # 去掉末尾的 / 和 ./ 之类，取到真实目录名
        [[ "${dir##*/}" =~ $SESSION_NAME_RE ]] || return 3
    fi
    printf '%s' "$dir"
}

# 参数的最后一级名字像不像会话文件夹名（用来区分「会话找不到」和「不认识的命令」）
_looks_like_session() {
    local b="$1"
    while [[ "$b" == */ ]]; do b="${b%/}"; done
    [[ "${b##*/}" =~ $SESSION_NAME_RE ]]
}

# meetap again [会议目录名] —— 对已有会议重新执行生成任务。
# 应对三类场景：1) materials/ 新增了资料要重新生成纪要；2) 上次转录或
# 纪要生成失败要重跑；3) 有新要求（编辑 <session>/extra-requirements.md
# 或 prompt.md 后重跑）。
# 断点续跑：有 transcript → 只重新生成纪要；无 transcript 但有音频 →
# 从转录开始重跑全链路。旧纪要归档到 archive/ 加时间戳，不覆盖丢失。
again_session() {
    local target="${1:-}"
    local extra_prompt="${2:-}"   # 可选：本次补充给 LLM 的重新生成要求
    local SESSION_DIR rc

    # 支持绝对路径或目录名；不给则取最近一次会议
    SESSION_DIR=$(resolve_session "$target"); rc=$?
    case $rc in
        1) _t ERR_AGAIN_SESSION_NOT_FOUND "$target" "$RECORDING_DIR"; exit 1 ;;
        2) _t ERR_AGAIN_NO_SESSIONS "$RECORDING_DIR"; exit 1 ;;
    esac

    local LOG_DIR="$SESSION_DIR/log"
    local TRANSCRIPT="$LOG_DIR/transcript.txt"
    mkdir -p "$LOG_DIR"
    _t AGAIN_TARGET "$(basename "$SESSION_DIR")"

    # 命令行补充要求：写入 extra-requirements.md，复用 build_prompt 的
    # ${extra_requirements} 注入通道（不改 prompt 模板）。未给参数则保留
    # 该文件原有内容（手工编辑的工作流不受影响）。
    if [[ -n "$extra_prompt" ]]; then
        printf '%s\n' "$extra_prompt" > "$SESSION_DIR/extra-requirements.md"
        _t AGAIN_EXTRA_PROMPT "$extra_prompt"
    fi

    # 归档旧纪要（md/html），避免重跑覆盖丢失历史版本
    local old note archive_dir="$SESSION_DIR/archive"
    for old in "$SESSION_DIR"/*.md "$SESSION_DIR"/*.html; do
        [[ -f "$old" ]] || continue
        case "$(basename "$old")" in
            prompt.md|extra-requirements.md) continue ;;
        esac
        mkdir -p "$archive_dir"
        note="$archive_dir/$(date +%H%M%S)_$(basename "$old")"
        mv "$old" "$note"
        _t AGAIN_ARCHIVED "$(basename "$old")"
    done

    if [[ -f "$TRANSCRIPT" ]]; then
        # 已有转录：只重新生成纪要（吸收新 materials / extra-requirements）。
        # 该路径不经 transcribe_recording 的日志重定向，这里显式把过程写入
        # meetap.log，与 start 保持一致。again 是前台命令，用 tee 兼顾终端可见；
        # 追加模式保留本会话既有日志（只归档旧纪要，不清空 log）。
        _t AGAIN_FROM_NOTES
        {
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] === meetap again (重新生成纪要): $(basename "$SESSION_DIR") ==="
            calendar_lookup_for_session "$SESSION_DIR"
            summarize_transcript "$SESSION_DIR"
        } 2>&1 | tee -a "$LOG_DIR/meetap.log"
    else
        # 无转录：从音频重跑全链路
        local AUDIO_FILE
        AUDIO_FILE=$(find "$SESSION_DIR" -maxdepth 1 -name "*.m4a" | sort | tail -1)
        if [[ -z "$AUDIO_FILE" ]]; then
            _t ERR_AGAIN_NO_AUDIO "$SESSION_DIR"
            exit 1
        fi
        _t AGAIN_FROM_TRANSCRIBE "$(basename "$AUDIO_FILE")"
        transcribe_recording "$AUDIO_FILE" "$SESSION_DIR"
    fi

    # 因休眠结束的会话补跑出转录后，清除待办提示
    if [[ -f "$PENDING_AGAIN_FILE" && -f "$TRANSCRIPT" ]] \
        && [[ "$(cat "$PENDING_AGAIN_FILE")" == "$(basename "$SESSION_DIR")" ]]; then
        rm -f "$PENDING_AGAIN_FILE"
    fi
}

# 会话里实际的纪要 md（mark 和贴标签回显共用）：目录下最新 *.md，排除 archive/、
# prompt.md、extra-requirements.md。（纪要经 smart_name_notes 已 mv 成
# <日期>_<时间>_<主题>.md，文件名不固定）
# NUL 分隔安全读取：SESSION_DIR 含空格时避免路径被词法拆词/glob 展开。
# meeting-notes.md 是生成中间态（正常会经 smart_name_notes 改名走掉），
# 若残留则词法上会误排到最后被当成「最新」，一并排除。没有纪要时输出为空。
_latest_notes_md() {
    local notes="" f
    while IFS= read -r -d '' f; do
        case "$(basename "$f")" in
            prompt.md|extra-requirements.md|meeting-notes.md) continue ;;
        esac
        notes="$f"   # sort 升序，最后一个即最新命名
    done < <(find "$1" -maxdepth 1 -type f -name "*.md" -print0 | sort -z)
    printf '%s' "$notes"
}

# 纪要要点高亮：给已生成的纪要 md 原地补 <mark> 高亮。独立后处理，不碰生成流程。
# 复用 summarize_via_* 作为 LLM 层；写回前过校验闸门，正文被改则拒写。
highlight_notes() {
    local target="${1:-}"
    local SESSION_DIR rc

    # 目录解析（与 again_session 共用 resolve_session）
    SESSION_DIR=$(resolve_session "$target"); rc=$?
    case $rc in
        1) _t ERR_HL_SESSION_NOT_FOUND "$target" "$RECORDING_DIR"; exit 1 ;;
        2) _t ERR_HL_NO_SESSIONS "$RECORDING_DIR"; exit 1 ;;
    esac

    local NOTES
    NOTES=$(_latest_notes_md "$SESSION_DIR")
    if [[ -z "$NOTES" ]]; then
        _t ERR_HL_NO_NOTES "$SESSION_DIR"
        exit 1
    fi
    _t HL_TARGET "$(basename "$NOTES")"

    # 找高亮模板（dev 树 / install 树两种前缀），需含 ${notes} 占位符
    local TPL="" cand
    for cand in \
        "$SCRIPT_DIR/../share/meetap/prompts/highlight.md" \
        "$SCRIPT_DIR/share/meetap/prompts/highlight.md"; do
        if [[ -f "$cand" ]] && grep -qF '${notes}' "$cand"; then
            TPL="$cand"; break
        fi
    done
    if [[ -z "$TPL" ]]; then
        _t ERR_HL_TEMPLATE_MISSING "share/meetap/prompts/highlight.md"
        exit 1
    fi

    # 组装 prompt：先剥掉纪要里可能已有的 <mark>（保证幂等），再替换 ${notes}。
    # 用 python 做替换：纪要正文含 & / 反斜杠等，sed/bash 替换不安全。
    local LOG_DIR="$SESSION_DIR/log"; mkdir -p "$LOG_DIR"
    local PROMPT_FILE="$LOG_DIR/.highlight-prompt.tmp"
    local LLM_OUT="$LOG_DIR/.highlight-out.tmp"
    local PYBIN="$VENV_PYTHON"; [[ -x "$PYBIN" ]] || PYBIN="$(command -v python3)"

    "$PYBIN" - "$TPL" "$NOTES" "$PROMPT_FILE" <<'PYEOF'
import re, sys
tpl_path, notes_path, out_path = sys.argv[1], sys.argv[2], sys.argv[3]
with open(tpl_path, encoding='utf-8') as f: tpl = f.read()
with open(notes_path, encoding='utf-8') as f: notes = f.read()
notes = re.sub(r'</?mark>', '', notes)          # 剥旧高亮，保证幂等
prompt = tpl.replace('${notes}', notes)          # 字面替换，不走 shell
with open(out_path, 'w', encoding='utf-8') as f: f.write(prompt)
PYEOF
    # 组装失败即退：模板/纪要读取异常时 PROMPT_FILE 可能为空，避免空 prompt 白调 LLM。
    if [[ ! -s "$PROMPT_FILE" ]]; then
        _t ERR_HL_LLM_FAILED
        rm -f "$PROMPT_FILE" "$LLM_OUT"
        exit 1
    fi

    _t HL_GENERATING
    # 复用现有 LLM 分派（接口：<prompt文件> <输出文件>）
    rm -f "$LLM_OUT"
    case "$CFG_AI_BACKEND" in
        claude-code) summarize_via_claude_code "$PROMPT_FILE" "$LLM_OUT" ;;
        bedrock|*)   summarize_via_bedrock "$PROMPT_FILE" "$LLM_OUT" ;;
    esac

    if [[ ! -s "$LLM_OUT" ]]; then
        _t ERR_HL_LLM_FAILED
        rm -f "$PROMPT_FILE" "$LLM_OUT"
        exit 1
    fi

    # 校验闸门：剥 mark 后与原文逐字节比对（原文同样剥 mark，应对重标）
    "$PYBIN" -c "$(_highlight_verify_py)" "$NOTES" "$LLM_OUT"
    local vrc=$?
    if [[ $vrc -ne 0 ]]; then
        _t ERR_HL_VERIFY_FAILED
        rm -f "$PROMPT_FILE" "$LLM_OUT"
        exit 1
    fi

    # 通过：写回原文件。若输出与原文完全相同（模型没标任何东西），提示未改动。
    if cmp -s "$NOTES" "$LLM_OUT"; then
        _t HL_UNCHANGED
    else
        mv "$LLM_OUT" "$NOTES"
        _t HL_DONE "$(basename "$NOTES")"
    fi
    # 规范化末尾空行：LLM 常吞掉尾部换行，且校验闸门宽容首尾空白，需由代码兜底
    # 保证 footer 后有空行，避免编辑器把签名 HTML 块显示成源码。
    _normalize_trailing_blank "$PYBIN" "$NOTES"
    rm -f "$PROMPT_FILE" "$LLM_OUT"
}

# ── 日历：停止录音后按录音时段找对应的会（第三批）──
# 匹配在 audio-multi-output calendar-query 里做（它只在已经完全授权时读、绝不请求授权）；
# 这里负责：去掉入会信息、截断参会人、写 materials/calendar.md、把摘要写进 meta.json。
# 查不到——没授权、没同步、没匹配到、超时、出错——都跳过，不写文件、不报错，只记一行日志，
# 不耽误转录和生成纪要。calendar.md 是给模型看的资料，和纪要一样固定用中文写。
CALENDAR_TIMEOUT=10

# 处理 calendar-query 的 JSON（stdin）。argv：会话目录、录音开始 / 结束（epoch 秒）。
# 输出 TSV：result\t状态\t…（给日志用），匹配到时再输出 meta\t<calendar 字段的 JSON>
_calendar_py() {
    cat <<'CALPY'
import json, os, re, sys, tempfile
from datetime import datetime

# ── 去掉入会信息：会议链接、会议号、密码、电话拨入。各家邀请模板五花八门，宁可多删 ──
URL_RE = re.compile(r'<?\b(?:https?|ftp)://[^\s<>"]+>?', re.I)
BARE_URL_RE = re.compile(r'\b(?:[\w-]+\.)*(?:chime\.aws|zoom\.(?:us|com)|teams\.(?:microsoft|live)\.com|'
                         r'meet\.google\.com|webex\.com|meeting\.tencent\.com|voovmeeting\.com|feishu\.cn|'
                         r'larksuite\.com|dingtalk\.com)(?:/\S*)?', re.I)
# 有这些词的整行删掉
STRONG_RE = re.compile(r'(?i)(meeting\s*(id|number|code)|webinar\s*id|会议\s*(号|id|码|密码)|conference\s*id|'
                       r'access\s*code|pass\s*code|password|\bpwd\b|密码|口令|\bpin\b|dial[- ]?in|拨入|'
                       r'one[- ]tap|tap to join|join by phone|电话入会|拨号|一键入会|local number|international numbers|toll[- ]free)')
# 「入会」类的词，配上链接或会议平台名才删（免得把「请大家准时参加」这类议程删掉）
JOIN_RE = re.compile(r'(?i)(\bjoin\b|入会|加入会议|会议链接|meeting link|click here)')
PLATFORM_RE = re.compile(r'(?i)(chime|zoom|teams|webex|google meet|腾讯会议|voov|飞书|lark|钉钉|meeting|会议|web|computer|mobile|phone|电话)')
# 像电话号码 / 会议号的数字串：+ 开头的号码、3-4-4 分组的 9 位以上数字、连续 9 位以上数字、,,123# 拨号串
NUMBER_RE = re.compile(r'(\+\d[\d\s().-]{6,}\d|\b\d{3}[\s-]?\d{3,4}[\s-]?\d{3,4}\b|\b\d{9,}\b|,,\d+#?)')
# Teams 等：两条长分隔线之间是整段入会信息
SEP_RE = re.compile(r'^\s*[_\-=~*]{20,}\s*$')
PUNCT = ' \t:：-–—|·•,，;；()（）[]【】<>'

def scrub(text):
    lines = (text or "").replace("\r\n", "\n").replace("\r", "\n").split("\n")
    seps = [i for i, l in enumerate(lines) if SEP_RE.match(l)]
    drop = set(seps)
    for a, b in zip(seps[0::2], seps[1::2]):
        drop.update(range(a, b + 1))
    out = []
    for i, l in enumerate(lines):
        if i in drop:
            continue
        had_url = bool(URL_RE.search(l) or BARE_URL_RE.search(l))
        if STRONG_RE.search(l) or NUMBER_RE.search(l):
            continue
        if JOIN_RE.search(l) and (had_url or PLATFORM_RE.search(l)):
            continue
        rest = BARE_URL_RE.sub("", URL_RE.sub("", l)).rstrip()
        if had_url and not rest.strip(PUNCT):
            continue
        out.append(rest)
    res = []
    for l in out:                       # 连续空行合并成一行，首尾空行去掉
        if not l.strip():
            if res and res[-1] == "":
                continue
            res.append("")
        else:
            res.append(l)
    while res and res[0] == "":
        res.pop(0)
    while res and res[-1] == "":
        res.pop()
    return "\n".join(res)

def scrub_location(loc):
    # 只剥首尾的分隔符，不剥括号（「会议室 A (演示楼 101)」要原样留着）
    parts = [scrub(x).replace("\n", " ").strip(" \t:：-–—|·•,，;；") for x in re.split(r"[;\n；]", loc or "")]
    return "; ".join(x for x in parts if x)

def name_of(p):
    # 没有名字时只用邮箱 @ 前面那段，calendar.md 里不出现完整邮箱
    return ((p or {}).get("name") or "").strip() or ((p or {}).get("email") or "").split("@")[0].strip()

def parse_time(iso):
    try:
        return datetime.fromisoformat(iso).astimezone()
    except (TypeError, ValueError):
        return None

def out(*fields):
    print("\t".join(str(f).replace("\t", " ").replace("\n", " ") for f in fields))

def main():
    session_dir, rec_start, rec_end = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
    raw = sys.stdin.read()
    if not raw.strip():
        out("result", "error", "no output")
        return
    try:
        d = json.loads(raw)
    except ValueError:
        out("result", "error", "bad json")
        return
    if not isinstance(d, dict):
        out("result", "error", "bad json")
        return
    status = d.get("status")
    if status == "not_authorized":
        out("result", "not_authorized", d.get("auth", ""))
        return
    if status != "ok":
        out("result", status if status in ("timeout", "error") else "error", d.get("message", ""))
        return
    m = d.get("match")
    if not isinstance(m, dict) or not (m.get("title") or "").strip():
        out("result", "none")
        return

    title = m["title"].strip()
    org = m.get("organizer") or {}
    org_name, org_email = name_of(org), (org.get("email") or "").lower()
    # 只列人：会议室、设备这类资源不算参会人；组织者单独一行，不在参会人里重复
    people = [a for a in m.get("attendees") or [] if a.get("type", "person") not in ("room", "resource")]
    def is_org(a):
        return bool(org_email and (a.get("email") or "").lower() == org_email) or bool(org_name and name_of(a) == org_name)
    rank = {"chair": 0, "required": 1, "unknown": 2, "optional": 3, "nonParticipant": 4}
    others = sorted([a for a in people if not is_org(a)], key=lambda a: rank.get(a.get("role"), 2))
    total = len(others) + (1 if org_name else 0)
    names = [n for n in (name_of(a) for a in others) if n]

    st, en = parse_time(m.get("start")), parse_time(m.get("end"))
    rs, rend = datetime.fromtimestamp(rec_start).astimezone(), datetime.fromtimestamp(rec_end).astimezone()
    lines = ["# 日历里的这场会", "",
             "> 来自系统日历，是会前的安排，实际讨论以录音为准。入会链接、会议号、密码、拨入电话已去掉。", "",
             "- 标题：" + title]
    if st and en:
        end_fmt = "%H:%M" if en.date() == st.date() else "%Y-%m-%d %H:%M"
        lines.append("- 时间：%s–%s（录音 %s–%s）" % (st.strftime("%Y-%m-%d %H:%M"), en.strftime(end_fmt),
                                                  rs.strftime("%H:%M"), rend.strftime("%H:%M")))
    if org_name:
        lines.append("- 组织者：" + org_name)
    if total > 30:
        lines.append("- 参会人：共 %d 人，下面只列组织者和前 20 位：%s" % (total, "、".join(names[:20])))
    elif names:
        lines.append("- 参会人（%d 人）：%s" % (total, "、".join(names)))
    loc = scrub_location(m.get("location"))
    if loc:
        lines.append("- 地点：" + loc)
    notes = scrub(m.get("notes"))
    if notes:
        lines += ["", "## 会议说明", "", notes]
    text = "\n".join(lines) + "\n"

    mdir = os.path.join(session_dir, "materials")
    os.makedirs(mdir, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".calendar.", suffix=".tmp", dir=mdir)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, os.path.join(mdir, "calendar.md"))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

    cal = {"title": title, "start": m.get("start", ""), "end": m.get("end", ""),
           "organizer": org_name, "attendee_count": total,
           "candidates": [c.get("title", "") for c in d.get("candidates") or [] if isinstance(c, dict) and c.get("title")],
           "looked_up_at": datetime.now().astimezone().isoformat(timespec="seconds")}
    out("meta", json.dumps(cal, ensure_ascii=False))
    out("result", "matched", title, int(m.get("overlap_sec", 0)) // 60)

main()
CALPY
}

# _run_with_timeout <秒> <命令…>：命令在自己的进程组里跑，到时连同子进程一起杀掉（退出码 124）
_run_with_timeout() {
    perl -e '
        my $t = shift;
        my $pid = fork;
        die "fork: $!" unless defined $pid;
        if (!$pid) { setpgrp(0, 0); exec @ARGV or exit 127; }
        $SIG{ALRM} = sub { kill "KILL", -$pid; waitpid($pid, 0); exit 124 };
        alarm $t;
        waitpid($pid, 0);
        exit($? >> 8);
    ' "$@"
}

# calendar_lookup <会话目录> <录音开始 epoch> <录音结束 epoch>：结果只输出一行日志
calendar_lookup() {
    local dir="$1" start="$2" end="$3" out py kind a b c msg
    [[ "$CFG_CALENDAR" == "on" && -x "$TOOL" ]] || return 0
    py="$VENV_PYTHON"; [[ -x "$py" ]] || py="$(command -v python3)"
    [[ -n "$py" ]] || return 0
    # 查询程序自己 10 秒超时；万一卡死，外面 12 秒强杀。放进单独的进程组、超时杀整个组：
    # 只杀它本身的话，它要是起了子进程，子进程还占着输出管道，这里就得一直等下去
    out=$(_run_with_timeout $((CALENDAR_TIMEOUT + 2)) \
        "$TOOL" calendar-query --start "$start" --end "$end" --timeout "$CALENDAR_TIMEOUT" </dev/null 2>/dev/null)
    while IFS=$'\t' read -r kind a b c; do
        case "$kind" in
            meta) _meta calendar-set "$dir" "$a" >/dev/null 2>&1 ;;
            result)
                case "$a" in
                    matched)        msg=$(_tn CAL_LOG_MATCHED "$b" "$c") ;;
                    none)           msg=$(_tn CAL_LOG_NONE) ;;
                    not_authorized) msg=$(_tn CAL_LOG_NOT_AUTHORIZED "$b" "$(basename "$0")") ;;
                    timeout)        msg=$(_tn CAL_LOG_TIMEOUT) ;;
                    *)              msg=$(_tn CAL_LOG_ERROR "$b") ;;
                esac
                echo "[$(date '+%H:%M:%S')] $msg"
                ;;
        esac
    done < <(printf '%s' "$out" | "$py" -I -c "$(_calendar_py)" "$dir" "$start" "$end" 2>/dev/null)
    return 0
}

# 按会话里的音频算录音时段（开始 = 文件名 meeting_YYYYMMDD_HHMMSS，结束 = 开始 + 音频时长）再查。
# 转录开始前（stop 的后台流程、again 从转录重跑）和 again 只重跑纪要时调用；
# materials/calendar.md 已经有了（查过，或用户自己放的）就不再查、不覆盖。
calendar_lookup_for_session() {
    local dir="$1" audio base start dur
    [[ "$CFG_CALENDAR" == "on" ]] || return 0
    [[ -e "$dir/materials/calendar.md" ]] && return 0
    audio=$(find "$dir" -maxdepth 1 -name "meeting_*.m4a" | sort | tail -1)
    base="${audio##*/}"
    [[ "$base" =~ ^meeting_([0-9]{8}_[0-9]{6})\.m4a$ ]] || return 0
    start=$(date -j -f "%Y%m%d_%H%M%S" "${BASH_REMATCH[1]}" +%s 2>/dev/null) || return 0
    dur=$(ffprobe -v quiet -show_entries format=duration -of csv=p=0 "$audio" </dev/null 2>/dev/null)
    dur="${dur%%.*}"
    [[ "$dur" =~ ^[0-9]+$ && "$dur" -gt 0 ]] || return 0
    calendar_lookup "$dir" "$start" "$((start + dur))"
}

# ── 会议标签（meta.json）与会话信息 ──
# meetap [<会话>] -g 标签 / --untag 标签 / -g（列标签） / meetap <会话>（显示信息）
# 标签存在会话目录最外层的 meta.json，不放 materials/（那里的东西会喂给模型）。
# 以后会被菜单栏 app 调用：没有终端时不交互、不阻塞、不起后台进程。
TAG_GUARD_HOURS=12   # 没写文件夹、没在录、最新一场早于这么多小时 → 有终端先确认，没终端直接拒绝

# meta.json 读写（Python：JSON 和多字节字符交给标准库，标签只经 argv 传入，不拼进代码）。
#   get <会话目录>                                    → "tags\t标签1\t标签2…"
#   update <会话目录> <recording_dir> (--add 标签 | --remove 标签)…
#       → 先输出相近标签提示（similar），再逐条输出 added/dup/removed/absent，最后 tags
#   all <recording_dir>                               → 每行 "场数\t标签"，场数从多到少
#   calendar-set <会话目录> <JSON>                     → 写 calendar 字段（第三批：日历信息）
#   get 另外输出 "calendar\t标题\t开始\t结束"（有 calendar 字段时）
# 统计范围：recording_dir 第一层的会话 + 20YY-MM 月份文件夹里的会话（用户按月手工挪老会议）。
# 不认识的字段原样保留；写入先写同目录临时文件再改名；meta.json 读不了时输出 error，不覆盖。
_meta_py() {
    cat <<'PYEOF'
import json, os, re, sys, tempfile
from datetime import datetime

SESSION_RE = re.compile(r'^20\d{6}_\d{4}(_.*)?$')
MONTH_RE = re.compile(r'^20\d{2}-\d{2}$')

def out(*fields):
    print("\t".join(fields))

def load(session_dir):
    path = os.path.join(session_dir, "meta.json")
    if not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
    if not isinstance(data, dict):
        raise ValueError("meta.json is not an object")
    tags = data.get("tags", [])
    if not isinstance(tags, list) or not all(isinstance(t, str) for t in tags):
        raise ValueError("tags is not a list of strings")
    return data

def write(session_dir, data):
    fd, tmp = tempfile.mkstemp(prefix=".meta.", suffix=".tmp", dir=session_dir)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, os.path.join(session_dir, "meta.json"))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

def sessions(rec):
    try:
        names = sorted(os.listdir(rec))
    except OSError:
        return
    for n in names:
        p = os.path.join(rec, n)
        if not os.path.isdir(p):
            continue
        if SESSION_RE.match(n):
            yield p
        elif MONTH_RE.match(n):
            for m in sorted(os.listdir(p)):
                q = os.path.join(p, m)
                if SESSION_RE.match(m) and os.path.isdir(q):
                    yield q

def tag_counts(rec):
    # 不分大小写归并：{casefold: [场数, {写法: 次数}]}
    counts = {}
    for s in sessions(rec):
        try:
            tags = load(s).get("tags", [])
        except (ValueError, OSError):
            continue   # 某一场的 meta.json 坏了，只是不计入统计
        seen = set()
        for t in tags:
            k = t.casefold()
            if k in seen:
                continue
            seen.add(k)
            c = counts.setdefault(k, [0, {}])
            c[0] += 1
            c[1][t] = c[1].get(t, 0) + 1
    return counts

def display(entry):
    spellings = entry[1]
    return max(spellings, key=lambda s: spellings[s])   # 最常用的写法，并列取先出现的

def cmd_update(session_dir, rec, ops):
    data = load(session_dir)
    tags = list(data.get("tags", []))
    counts = tag_counts(rec)
    changed = False
    for op, tag in ops:
        k = tag.casefold()
        if op == "--add":
            if any(t.casefold() == k for t in tags):
                out("dup", tag)
                continue
            if k not in counts:   # 从没用过的新标签：一个包含另一个就算相近
                for ek, entry in counts.items():
                    if k in ek or ek in k:
                        out("similar", tag, display(entry), str(entry[0]))
            tags.append(tag)
            changed = True
            out("added", tag)
        else:
            hit = [t for t in tags if t.casefold() == k]
            if not hit:
                out("absent", tag)
                continue
            tags = [t for t in tags if t.casefold() != k]
            changed = True
            out("removed", hit[0])
    if changed:
        if not data:
            data = {"schema": 1, "session": os.path.basename(session_dir)}
        data.setdefault("schema", 1)
        data.setdefault("session", os.path.basename(session_dir))
        data["tags"] = tags
        data["updated_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
        write(session_dir, data)
    out("tags", *tags)

def one_line(v):
    return str(v).replace("\t", " ").replace("\n", " ").replace("\r", " ").strip()

def cmd_calendar_set(session_dir, cal_json):
    data = load(session_dir)
    cal = json.loads(cal_json)
    if not isinstance(cal, dict):
        raise ValueError("calendar is not an object")
    if not data:
        data = {"schema": 1, "session": os.path.basename(session_dir)}
    data.setdefault("schema", 1)
    data.setdefault("session", os.path.basename(session_dir))
    data["calendar"] = cal
    data["updated_at"] = datetime.now().astimezone().isoformat(timespec="seconds")
    write(session_dir, data)
    out("ok")

def main(argv):
    cmd = argv[1]
    try:
        if cmd == "get":
            data = load(argv[2])
            out("tags", *data.get("tags", []))
            cal = data.get("calendar")
            if isinstance(cal, dict) and isinstance(cal.get("title"), str) and cal["title"].strip():
                out("calendar", one_line(cal["title"]), one_line(cal.get("start", "")), one_line(cal.get("end", "")))
        elif cmd == "calendar-set":
            cmd_calendar_set(argv[2], argv[3])
        elif cmd == "update":
            rest = argv[4:]
            cmd_update(argv[2], argv[3], list(zip(rest[0::2], rest[1::2])))
        elif cmd == "all":
            counts = tag_counts(argv[2])
            for e in sorted(counts.values(), key=lambda e: (-e[0], display(e).casefold())):
                out(str(e[0]), display(e))
    except ValueError:
        out("error", "badjson")
        sys.exit(1)
    except OSError as e:
        out("error", "io", str(e).replace("\t", " ").replace("\n", " "))
        sys.exit(1)

main(sys.argv)
PYEOF
}

_meta() {
    local py="$VENV_PYTHON"
    [[ -x "$py" ]] || py="$(command -v python3)"
    if [[ -z "$py" ]]; then
        printf 'error\tnopython\n'
        return 1
    fi
    "$py" -I -c "$(_meta_py)" "$@" </dev/null
}

# 读一场会的标签到 SESSION_TAGS 数组，日历标题到 SESSION_CAL_TITLE / _START / _END；
# meta.json 读不了时返回 1
_read_tags() {
    local line f ok=1
    SESSION_TAGS=()
    SESSION_CAL_TITLE=""; SESSION_CAL_START=""; SESSION_CAL_END=""
    while IFS= read -r line; do
        IFS=$'\t' read -r -a f <<< "$line"
        case "${f[0]}" in
            tags) SESSION_TAGS=("${f[@]:1}"); ok=0 ;;
            calendar) SESSION_CAL_TITLE="${f[1]}"; SESSION_CAL_START="${f[2]:-}"; SESSION_CAL_END="${f[3]:-}" ;;
        esac
    done < <(_meta get "$1")
    return $ok
}

# 正在录的那场：ffmpeg pid 活着，且 state/session-dir 指向存在的目录。
# start 先建会话目录、写 session-dir，后起 ffmpeg 写 pid；这一瞬间算「没在录」，
# 默认目标落到最新一场——正是刚建好的目录，不会贴到上一场。
_recording_session_dir() {
    [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null || return 1
    local sd
    sd=$(cat "$STATE_DIR/session-dir" 2>/dev/null)
    [[ -n "$sd" && -d "$sd" ]] || return 1
    printf '%s' "$sd"
}

_same_dir() {
    [[ "$(cd -- "$1" 2>/dev/null && pwd -P)" == "$(cd -- "$2" 2>/dev/null && pwd -P)" ]]
}

# 会话开始时间（epoch 秒），从文件夹名 20YYMMDD_HHMM 解析
_session_start_epoch() {
    date -j -f "%Y%m%d_%H%M%S" "${1:0:13}00" +%s 2>/dev/null
}

# 开始时间的短写法：当年写 11-18 12:01，跨年写 2025-11-18 12:01
_session_when() {
    local b="$1"
    if [[ "${b:0:4}" == "$(date +%Y)" ]]; then
        printf '%s-%s %s:%s' "${b:4:2}" "${b:6:2}" "${b:9:2}" "${b:11:2}"
    else
        printf '%s-%s-%s %s:%s' "${b:0:4}" "${b:4:2}" "${b:6:2}" "${b:9:2}" "${b:11:2}"
    fi
}

# 时长（分钟，四舍五入）：正在录 → 从 pid 文件时间算已录时长（同 status）；
# 否则用 ffprobe 读会话里的音频（同 stop）。音频按 audio_persist 删了、没装 ffprobe
# 都输出空，调用方显示「未知」。不用 transcribe-raw.json 兜底：它只记到最后一句话，
# 可能比录音短得多。
_session_minutes() {
    local dir="$1" recording="$2" secs audio st
    if [[ "$recording" == true ]]; then
        st=$(stat -f %m "$PID_FILE" 2>/dev/null) || return 0
        secs=$(( $(date +%s) - st ))
    else
        audio=$(find "$dir" -maxdepth 1 -name "*.m4a" | sort | tail -1)
        [[ -n "$audio" ]] && command -v ffprobe >/dev/null || return 0
        secs=$(ffprobe -v quiet -show_entries format=duration -of csv=p=0 "$audio" </dev/null 2>/dev/null)
        secs="${secs%%.*}"
        [[ "$secs" =~ ^[0-9]+$ ]] || return 0
    fi
    printf '%d' $(( (secs + 30) / 60 ))
}

_fmt_minutes() {
    if [[ -z "$1" ]]; then _tn DUR_UNKNOWN
    elif (( $1 < 1 )); then _tn DUR_UNDER_MIN
    else _tn DUR_MIN "$1"
    fi
}

# 纪要标题：纪要文件名 2026-11-18_1201_<标题>.md 里的 <标题>；没有纪要输出为空
_notes_title() {
    local f name
    f=$(_latest_notes_md "$1")
    [[ -n "$f" ]] || return 0
    name="${f##*/}"
    name="${name%.md}"
    [[ "$name" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}_(.+)$ ]] && name="${BASH_REMATCH[1]}"
    printf '%s' "$name"
}

# 一场会的摘要（贴标签回显、列标签、护栏提示共用）：11-18 12:01（73 分钟 · 纪要：标题）
_session_brief() {
    local dir="$1" recording="$2" m dur title notes
    m=$(_session_minutes "$dir" "$recording")
    if [[ -n "$m" ]]; then dur=$(_fmt_minutes "$m"); else dur=$(_tn BRIEF_DUR_UNKNOWN); fi
    [[ "$recording" == true ]] && dur=$(_tn BRIEF_RECORDING "$dur")
    title=$(_notes_title "$dir")
    if [[ -n "$title" ]]; then notes=$(_tn BRIEF_NOTES "$title"); else notes=$(_tn BRIEF_NO_NOTES); fi
    _tn BRIEF "$(_session_when "${dir##*/}")" "$dur" "$notes"
}

_join_tags() {
    local sep out="" t
    sep=$(_tn TAG_SEP)
    for t in "$@"; do out="${out:+$out$sep}$t"; done
    [[ -n "$out" ]] || out=$(_tn TAGS_NONE)
    printf '%s' "$out"
}

# 拼提示里的命令示例：含空格、引号等的标签加单引号，用户照抄就能用
_shell_word() {
    case "$1" in
        *[[:space:]\'\"\\\$\`\!\*\?\[\]\(\)\{\}\;\&\|\<\>\#\~]*)
            printf "'%s'" "${1//\'/\'\\\'\'}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# 校验一个标签值，通过则把去掉首尾空白后的值放进 TAG_VALUE
_check_tag() {
    local v="$1"
    v="${v#"${v%%[![:space:]]*}"}"
    v="${v%"${v##*[![:space:]]}"}"
    if [[ -z "$v" ]]; then
        _t ERR_TAG_EMPTY; return 1
    elif [[ "$v" == *[[:cntrl:]]* ]]; then
        _t ERR_TAG_BAD_CHAR; return 1
    elif [[ "$v" == -* ]]; then
        _t ERR_TAG_DASH "$v"; return 1
    elif _looks_like_session "$v" || [[ "$v" =~ ^20[0-9]{6}_[0-9]{4} ]]; then
        # -g 后面跟的像会话文件夹名：多半是参数顺序写反了
        _t ERR_TAG_LOOKS_LIKE_SESSION "$v" "$(basename "$0")" "$v"; return 1
    fi
    TAG_VALUE="$v"
}

# 12 小时护栏：没写文件夹、没在录、最新一场开始于 TAG_GUARD_HOURS 小时以前。
# 有终端先问确认；没终端（菜单栏 app 调用）直接拒绝，提示写明文件夹。两种情况都不写文件。
_tag_guard() {
    local dir="$1" explicit="$2" recording="$3" start s brief
    shift 3
    [[ "$explicit" == true || "$recording" == true ]] && return 0
    start=$(_session_start_epoch "${dir##*/}")
    [[ -n "$start" ]] || return 0
    (( $(date +%s) - start < TAG_GUARD_HOURS * 3600 )) && return 0
    brief=$(_session_brief "$dir" false)
    if [[ -t 0 ]]; then
        ui_confirm "$(_tn TAG_GUARD_CONFIRM "$brief" "$TAG_GUARD_HOURS")" && return 0
        _t TAG_GUARD_CANCELLED
        return 1
    fi
    s="$(basename "$0") ${dir##*/}"
    while (( $# >= 2 )); do
        [[ "$1" == --add ]] && s+=" -g" || s+=" --untag"
        s+=" $(_shell_word "$2")"
        shift 2
    done
    _t ERR_TAG_GUARD_REFUSED "$brief" "$TAG_GUARD_HOURS" "$s"
    return 1
}

_meta_error() {
    case "$1" in
        badjson)  _t ERR_META_BAD "$2/meta.json" ;;
        nopython) _t ERR_META_NO_PYTHON ;;
        *)        _t ERR_META_IO "$2/meta.json" "${3:-}" ;;
    esac
}

# 贴标签 / 撤标签，然后回显这场是哪一场、现在有哪些标签
_tag_update() {
    local dir="$1" recording="$2" line got=false err="" errinfo="" brief
    shift 2
    local f added=() dups=() removed=() absent=() similar=() tags=()
    while IFS= read -r line; do
        IFS=$'\t' read -r -a f <<< "$line"
        case "${f[0]}" in
            similar) similar+=("$(_tn TAG_SIMILAR "${f[2]}" "${f[3]}")") ;;
            added)   added+=("${f[1]}") ;;
            dup)     dups+=("${f[1]}") ;;
            removed) removed+=("${f[1]}") ;;
            absent)  absent+=("${f[1]}") ;;
            tags)    tags=("${f[@]:1}"); got=true ;;
            error)   err="${f[1]}"; errinfo="${f[2]}" ;;
        esac
    done < <(_meta update "$dir" "$RECORDING_DIR" "$@")
    if [[ -n "$err" || "$got" != true ]]; then
        _meta_error "${err:-io}" "$dir" "$errinfo"
        exit 1
    fi

    brief=$(_session_brief "$dir" "$recording")
    for line in "${similar[@]}"; do printf '%s\n' "$line"; done
    (( ${#added[@]} )) && _t TAG_ADDED "$brief" "$(_join_tags "${added[@]}")"
    (( ${#removed[@]} )) && _t TAG_REMOVED "$brief" "$(_join_tags "${removed[@]}")"
    (( ${#added[@]} + ${#removed[@]} )) || _t TAG_UNCHANGED "$brief"
    (( ${#dups[@]} )) && _t TAG_DUP "$(_join_tags "${dups[@]}")"
    (( ${#absent[@]} )) && _t TAG_ABSENT "$(_join_tags "${absent[@]}")"
    _t TAG_CURRENT "$(_join_tags "${tags[@]}")"
    return 0
}

# 日历标题当标签建议（_read_tags 之后调用）：标题还不是这场的标签、也能当标签用时才提示
_suggest_calendar_tag() {
    local dir="$1" explicit="$2" title="$SESSION_CAL_TITLE" low t cmd
    [[ -n "$title" ]] || return 0
    _check_tag "$title" >/dev/null 2>&1 || return 0
    title="$TAG_VALUE"
    low=$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]')
    for t in "${SESSION_TAGS[@]}"; do
        [[ "$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]')" == "$low" ]] && return 0
    done
    cmd="$(basename "$0")"
    [[ "$explicit" == true ]] && cmd+=" $(_shell_word "$(_session_ref "$dir")")"
    _t TAGLIST_CAL_SUGGEST "$title" "$cmd -g $(_shell_word "$title")"
}

# 列出这场的标签，以及用过的全部标签和各自的场数
_tag_list() {
    local dir="$1" explicit="$2" recording="$3" prefix="" cur n t
    local names=() nums=() i
    if _read_tags "$dir"; then cur=$(_join_tags "${SESSION_TAGS[@]}"); else cur=$(_tn META_UNREADABLE); fi
    if [[ "$explicit" != true ]]; then
        if [[ "$recording" == true ]]; then prefix=$(_tn TARGET_RECORDING); else prefix=$(_tn TARGET_LATEST); fi
    fi
    _t TAGLIST_SESSION "$prefix" "$(_session_brief "$dir" "$recording")" "$cur"
    _suggest_calendar_tag "$dir" "$explicit"
    while IFS=$'\t' read -r n t; do
        [[ "$n" =~ ^[0-9]+$ ]] || continue
        nums+=("$n"); names+=("$t")
    done < <(_meta all "$RECORDING_DIR")
    if (( ${#names[@]} == 0 )); then
        _t TAGLIST_NONE "$(basename "$0")"
        return 0
    fi
    _t TAGLIST_ALL_HEADER "${#names[@]}"
    for (( i = 0; i < ${#names[@]}; i++ )); do
        _t TAGLIST_ALL_ITEM "${names[$i]}" "${nums[$i]}"
    done
}

# meetap <会话>：显示这场会的信息，不开录
# 会话的写法：在 recording_dir 下就写相对路径（20261118_1201、2026-10/20261008_1046），否则写全路径
_session_ref() {
    local rd
    rd="$(cd -- "$RECORDING_DIR" 2>/dev/null && pwd)"
    if [[ -n "$rd" && "$1" == "$rd/"* ]]; then printf '%s' "${1#"$rd/"}"; else printf '%s' "$1"; fi
}

# 日历时段的短写法：12:00–13:00（取 ISO 时间里的时分）
_cal_span() {
    [[ -n "$1" && -n "$2" ]] || return 0
    printf '%s–%s' "${1:11:5}" "${2:11:5}"
}

_session_info() {
    local dir="$1" recording="$2" b="${1##*/}" rel title tags
    rel=$(_session_ref "$dir")
    title=$(_notes_title "$dir")
    if _read_tags "$dir"; then tags=$(_join_tags "${SESSION_TAGS[@]}"); else tags=$(_tn META_UNREADABLE); fi
    _t INFO_HEADER "$rel"
    _t INFO_START "${b:0:4}-${b:4:2}-${b:6:2} ${b:9:2}:${b:11:2}"
    if [[ "$recording" == true ]]; then
        _t INFO_DURATION_RECORDING "$(_fmt_minutes "$(_session_minutes "$dir" true)")"
    else
        _t INFO_DURATION "$(_fmt_minutes "$(_session_minutes "$dir" false)")"
    fi
    if [[ -n "$title" ]]; then _t INFO_NOTES "$title"; else _t INFO_NO_NOTES; fi
    _t INFO_TAGS "$tags"
    [[ -n "$SESSION_CAL_TITLE" ]] && _t INFO_CALENDAR "$SESSION_CAL_TITLE" "$(_cal_span "$SESSION_CAL_START" "$SESSION_CAL_END")"
    if [[ "$recording" == true ]]; then _t INFO_STATE_RECORDING; else _t INFO_STATE_ENDED; fi
}

# 入口：session_cmd <会话目录或空> [参数…]
# 会话目录为空时，默认目标是正在录的那场，没在录就是最新一场（只看 recording_dir 第一层）。
session_cmd() {
    local SESSION_DIR="$1" cmd arg dir rc list=false explicit=true recording=false rec_dir=""
    local ops=()
    shift
    cmd=$(basename "$0")
    while (( $# > 0 )); do
        arg="$1"
        case "$arg" in
            -g|--tag|--untag)
                if (( $# == 1 )); then
                    [[ "$arg" == --untag ]] && { _t ERR_UNTAG_NEEDS_VALUE "$cmd"; exit 1; }
                    list=true
                    shift
                    continue
                fi
                _check_tag "$2" || exit 1
                if [[ "$arg" == --untag ]]; then ops+=(--remove "$TAG_VALUE"); else ops+=(--add "$TAG_VALUE"); fi
                shift 2
                ;;
            -t|--test|-d|--duration|-b|--background|-m|--mute-mic|--mute-microphone)
                _t ERR_TAG_WITH_START_OPT "$cmd" "$cmd"
                exit 1
                ;;
            -*)
                _t ERR_UNKNOWN_OPTION "$arg"
                exit 1
                ;;
            *)
                # 位置参数只能有一个，而且必须是会话（名字或路径）
                if [[ -z "$SESSION_DIR" ]] && dir=$(resolve_session "$arg" strict); then
                    SESSION_DIR="$dir"
                elif [[ -z "$SESSION_DIR" ]] && _looks_like_session "$arg"; then
                    _t ERR_SESSION_NOT_FOUND "$arg" "$RECORDING_DIR"
                    exit 1
                else
                    _t ERR_TAG_EXTRA_ARG "$arg" "$cmd"
                    exit 1
                fi
                shift
                ;;
        esac
    done
    if $list && (( ${#ops[@]} > 0 )); then
        _t ERR_TAG_MISSING_VALUE "$cmd"
        exit 1
    fi

    rec_dir=$(_recording_session_dir) || rec_dir=""
    if [[ -z "$SESSION_DIR" ]]; then
        explicit=false
        if [[ -n "$rec_dir" ]]; then
            SESSION_DIR="$rec_dir"
        else
            SESSION_DIR=$(resolve_session ""); rc=$?
            if (( rc != 0 )); then
                _t ERR_TAG_NO_SESSIONS "$RECORDING_DIR"
                exit 1
            fi
        fi
    fi
    [[ -n "$rec_dir" ]] && _same_dir "$SESSION_DIR" "$rec_dir" && recording=true

    if (( ${#ops[@]} > 0 )); then
        _tag_guard "$SESSION_DIR" "$explicit" "$recording" "${ops[@]}" || exit 1
        _tag_update "$SESSION_DIR" "$recording" "${ops[@]}"
    elif $list; then
        _tag_list "$SESSION_DIR" "$explicit" "$recording"
    else
        _session_info "$SESSION_DIR" "$recording"
    fi
}

# tap 健康探针：判断 ffmpeg 是否已从 FIFO 读到真实 PCM。
# 原理：ffmpeg 只有拿到音频数据才会在日志里推进 "time=NN"；若 Process Tap
# 的 IO 回调没启动（AudioDeviceStart 返回成功但回调静默——macOS 偶发），
# FIFO 无数据、ffmpeg 阻塞在读取，日志停在 "Press [q] to stop" 且 time 永远
# 为 0。用 time 是否 > 0 作为「音频真的在流动」的确定性信号——不能用波形/
# tap-level（那是麦克风电平，回调独立，静默空录时照样在动）。
_tap_audio_flowing() {
    local logf="$1"
    # 取日志里最后一个 time=HH:MM:SS.xx，判断是否已越过 0
    local t
    t=$(grep -oE 'time=[0-9:.]+' "$logf" 2>/dev/null | tail -1 | cut -d= -f2)
    [[ -z "$t" ]] && return 1
    # 归一化去掉冒号和点，非零即为在推进（00:00:00.00 → 0）
    local digits="${t//[:.]/}"
    [[ "$digits" =~ ^0*$ ]] && return 1
    return 0
}

# 前台模式下，后台子进程放进独立进程组（set -m），终端 Ctrl-C 只打到 start 本身、
# 由 trap 走有序 stop；否则 SIGINT 会同时打到 ffmpeg / tap，与收尾抢跑。
# 只包住 `cmd &` 那一行：-m 常开会让前台的 sleep 等命令也各自成组、抢走终端信号。
_jobctl_on()  { $FOREGROUND && set -m; }
_jobctl_off() { set +m; }

# start 前台模式下 Ctrl-C / 关窗口 / kill：等效 meetap stop
_on_start_interrupt() {
    trap '' INT TERM HUP QUIT     # 防止 stop 过程中再次 Ctrl-C 重入
    # trap 在命令之间执行：若恰好落在 `cmd &` 与写 PID 文件之间，刚拉起的子进程
    # 没登记，stop 找不到它（典型：ffmpeg 卡在打开 tap.fifo，tap 被杀后永远阻塞）。
    # $! 此时已是它的 PID：未出现在任何 PID 文件里就直接清掉
    local last=$!
    if [[ -n "$last" ]] && kill -0 "$last" 2>/dev/null \
        && ! cat "$PID_FILE" "$TAP_PID_FILE" "$AUTOSTOP_PID_FILE" \
                 "$SLEEPWATCH_PID_FILE" 2>/dev/null | grep -qx "$last"; then
        kill "$last" 2>/dev/null; sleep 0.3; kill -9 "$last" 2>/dev/null
    fi
    teardown_statusbar "$START_TTY" 2>/dev/null
    stop_recording
    exit 0
}

# 结束 sleep-watch：PID 文件可能残留（PID 已被无关进程复用），校验命令行再 kill
_kill_sleepwatch() {
    local pid
    pid=$(cat "$SLEEPWATCH_PID_FILE" 2>/dev/null)
    if [[ -n "$pid" ]] && ps -p "$pid" -o command= 2>/dev/null | grep -q 'sleep-watch'; then
        kill "$pid" 2>/dev/null
    fi
    rm -f "$SLEEPWATCH_PID_FILE"
}

# 休眠监听：系统休眠前以 stop --sleep 结束录音，唤醒后发通知（所有运行模式都启动）
start_sleepwatch() {
    _kill_sleepwatch
    _jobctl_on
    "$TOOL" sleep-watch "$SCRIPT_DIR/meetap" "$PID_FILE" \
        < /dev/null > "$STATE_DIR/sleepwatch.log" 2>&1 &
    local pid=$!
    _jobctl_off
    echo "$pid" > "$SLEEPWATCH_PID_FILE"
    disown "$pid"
}

# 前台等待：在当前终端跑波形直到录音结束。Ctrl-C 走 trap；-d 自停或休眠触发的
# stop 杀掉 ffmpeg 后循环自然退出
foreground_wait() {
    sleep 0.1
    setup_statusbar "$START_TTY"
    start_visualizer "$START_TTY"
    # 波形写终端失败会提前跳出循环；录音仍在就继续守着，保证 Ctrl-C 依然有效
    while kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; do sleep 1; done
    # 录音已由别处结束（-d 自停 / 休眠 / 其他终端 stop）：再按 Ctrl-C 直接退出，不再进 stop
    trap - INT TERM HUP QUIT
    teardown_statusbar "$START_TTY" 2>/dev/null
    # ffmpeg 退出时 stop 还在收尾（杀 tap、恢复设备、ffprobe…）：
    # session-dir 被删即表示待办已写入（stop 先写待办再删 session-dir），最多等 10s
    local i
    for ((i = 0; i < 50; i++)); do
        [[ -f "$STATE_DIR/session-dir" ]] || break
        sleep 0.2
    done
    local session
    session=$(basename "$SESSION_DIR")
    if [[ -f "$PENDING_AGAIN_FILE" && "$(cat "$PENDING_AGAIN_FILE")" == "$session" ]]; then
        _t SLEEP_STOPPED_HINT "$0" "$session"
    fi
}

# ── 系统版本门槛与 2.0 升级迁移检查（start、setup 共用）──
MIN_MACOS_MAJOR=14
MIN_MACOS_MINOR=4

# macOS 低于 14.4 → 报错，返回 1。sw_vers 走 PATH（测试里放假的 sw_vers 伪造版本号）；
# 读不到版本号时不拦，交给 audio-tap tap-supported 兜底。
_require_macos() {
    local v ma mi
    v=$(sw_vers -productVersion 2>/dev/null)
    [[ "$v" =~ ^([0-9]+)(\.([0-9]+))? ]] || return 0
    ma=${BASH_REMATCH[1]}; mi=${BASH_REMATCH[3]:-0}
    if (( ma > MIN_MACOS_MAJOR || (ma == MIN_MACOS_MAJOR && mi >= MIN_MACOS_MINOR) )); then
        return 0
    fi
    _t ERR_MACOS_TOO_OLD "$v" "$MIN_MACOS_MAJOR.$MIN_MACOS_MINOR"
    return 1
}

# 系统输出还停在 BlackHole 上：1.x 崩溃后没恢复，或者是用户有意切过去的（给别的软件用）。
# 只有 1.x 留下的 original-output.* 状态文件在、原设备也找得到时才自动切回；
# 否则有终端时让用户选（第一个、也是默认选项是「保持不变」），没终端只提示。
# 不拦录音：Tap 照样录得到，只是用户自己听不见。
_migrate_output_device() {
    [[ -x "$TOOL" ]] || return 0
    local cur orig_uid orig_name id line dev_uid choice keep i
    cur=$("$TOOL" default-output-name 2>/dev/null) || return 0
    if [[ "$cur" != *BlackHole* ]]; then
        rm -f "$ORIGINAL_UID_FILE" "$ORIGINAL_NAME_FILE"   # 不在 BlackHole 上，旧状态文件已无用
        return 0
    fi

    if [[ -f "$ORIGINAL_UID_FILE" ]]; then
        orig_uid=$(cat "$ORIGINAL_UID_FILE")
        orig_name=$(cat "$ORIGINAL_NAME_FILE" 2>/dev/null)
        if id=$("$TOOL" find-uid "$orig_uid" 2>/dev/null) && "$TOOL" set-default "$id" >/dev/null 2>&1; then
            rm -f "$ORIGINAL_UID_FILE" "$ORIGINAL_NAME_FILE"
            _t MIGRATE_OUTPUT_RESTORED "$cur" "${orig_name:-$orig_uid}"
            return 0
        fi
    fi

    if [[ ! -t 0 ]]; then
        _t MIGRATE_OUTPUT_ON_BH "$cur"
        return 0
    fi
    local names=() ids=()
    while IFS='|' read -r line dev_uid id; do
        [[ -n "$line" && "$line" != *BlackHole* && "$id" =~ ^[0-9]+$ ]] || continue
        names+=("$line"); ids+=("$id")
    done < <("$TOOL" list 2>/dev/null)
    _t MIGRATE_OUTPUT_ASK "$cur"
    keep=$(_tn MIGRATE_OUTPUT_KEEP)
    choice=$(ui_choose "$keep" "${names[@]}")
    for (( i = 0; i < ${#names[@]}; i++ )); do
        if [[ "${names[$i]}" == "$choice" ]]; then
            if "$TOOL" set-default "${ids[$i]}" >/dev/null 2>&1; then
                _t MIGRATE_OUTPUT_SWITCHED "$choice"
            else
                _t MIGRATE_OUTPUT_SWITCH_FAILED "$choice"
            fi
            return 0
        fi
    done
    _t MIGRATE_OUTPUT_KEPT "$cur"
}

# 老配置 audio_capture = blackhole：2.0 起只有 Tap，照样走 Tap，提示删掉这一行。
# auto / tap 不提示（旧模板默认就写了 auto，几乎人人都有）。
_warn_old_capture_config() {
    [[ "$CFG_AUDIO_CAPTURE" == "blackhole" ]] && _t WARN_OLD_CAPTURE_CONFIG "$CONFIG_FILE"
    return 0
}

# setup：会议 App 的扬声器是不是还指着 BlackHole（只读，不改任何 App 的配置）。
# Zoom 的设置在 viper.ini 里（设备名的十六进制）读得出来；Teams、腾讯会议读不到配置，
# 系统里还装着 BlackHole 时提示一句怎么检查。
_check_meeting_apps() {
    local ini="$HOME/Library/Application Support/zoom.us/data/viper.ini" k v name zoom_bh=""
    if [[ -f "$ini" ]]; then
        for k in AECSPK AECBSSPK; do
            v=$(grep "^$k=" "$ini" | head -1 | cut -d= -f2)
            name=$(printf '%s' "$v" | xxd -r -p 2>/dev/null)
            [[ "$name" == *BlackHole* ]] && zoom_bh="$name"
        done
        [[ -n "$zoom_bh" ]] && _t MIGRATE_ZOOM_ON_BH "$zoom_bh"
    fi
    if [[ -x "$TOOL" ]] && "$TOOL" list 2>/dev/null | grep -q 'BlackHole'; then
        _t MIGRATE_APPS_BH_HINT
    fi
}

start_recording() {
    _require_macos || exit 1
    local VERBOSE=false
    local MAX_DURATION_MIN=""   # 会议时长上限（分钟，可选）
    local MUTE_MIC=false        # 只录系统音（录网页直播时屏蔽现场环境声）
    local BACKGROUND=false      # -b：维持旧的后台行为，不占用终端
    # 解析选项：-t/--test 显示详情；-d/--duration N 指定会议时长上限（分钟）；
    # -m/--mute-mic/--mute-microphone 不录麦克风
    # 选项可任意顺序、可写在会议名前后；第一个非选项参数为会议名称
    # （meetap start 季度架构评审）
    local MEETING_NAME=""
    while (( $# > 0 )); do
        case "$1" in
            -t|--test)
                VERBOSE=true
                echo "true" > "$STATE_DIR/test-mode"
                shift
                ;;
            -d|--duration)
                MAX_DURATION_MIN="${2:-}"
                if ! [[ "$MAX_DURATION_MIN" =~ ^[1-9][0-9]*$ ]]; then
                    _t ERR_BAD_DURATION "$MAX_DURATION_MIN"
                    exit 1
                fi
                shift 2
                ;;
            -b|--background)
                BACKGROUND=true
                shift
                ;;
            -m|--mute-mic|--mute-microphone)
                MUTE_MIC=true
                shift
                ;;
            -*)
                _t ERR_UNKNOWN_OPTION "$1"
                exit 1
                ;;
            *)
                [[ -z "$MEETING_NAME" ]] && MEETING_NAME="$1"
                shift
                ;;
        esac
    done
    [[ "$VERBOSE" == "false" ]] && rm -f "$STATE_DIR/test-mode"

    # 检查是否已在录制
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        _t ERR_ALREADY_RECORDING "$(cat "$PID_FILE")"
        _t HINT_STOP_FIRST "$0"
        exit 1
    fi
    # 必须在「已在录制」检查之后：录音进行中不能去动系统输出设备
    _migrate_output_device
    _warn_old_capture_config
    # 前台模式：有 TTY 且未加 -b。start 不退出、跑波形，Ctrl-C / 关窗口 ≡ meetap stop。
    # trap 必须在拉起任何子进程之前装：子进程在独立进程组里收不到 Ctrl-C，装晚了，
    # 启动阶段的 Ctrl-C 只会杀掉 start 自己，留下孤儿录音。
    # 也必须在「已在录制」检查之后装，否则那时的 Ctrl-C 会误停正在进行的录音。
    START_TTY=$(tty 2>/dev/null)
    [[ "$START_TTY" == "not a tty" ]] && START_TTY=""
    if ! $BACKGROUND && [[ -n "$START_TTY" ]]; then
        FOREGROUND=true
        trap '_on_start_interrupt' INT TERM HUP QUIT
    fi

    # 清理残留状态。关键：上次异常停止可能留下孤儿 audio-tap（stop 只杀
    # ffmpeg；tap 依赖 EPIPE 自杀，但 IO 回调停摆时永不触发）。孤儿会占住
    # 音频链路，让新 ffmpeg 打不开麦克风输入 → 卡死 → 录音全丢，必须先清扫。
    pkill -f "audio-tap tap-start" 2>/dev/null && sleep 0.5
    rm -f "$PID_FILE" "$TAP_PID_FILE" "$MAX_DURATION_FILE"

    # 检查依赖
    if [[ ! -x "$TOOL" ]]; then
        _t ERR_TOOL_MISSING "$TOOL"
        exit 1
    fi
    if ! command -v ffmpeg &>/dev/null; then
        _t ERR_FFMPEG_MISSING
        exit 1
    fi

    # --- 音频采集：只有 Process Tap 一条路（2.0 起） ---
    local TAP_TOOL="$SCRIPT_DIR/audio-tap"
    if [[ ! -x "$TAP_TOOL" ]] || ! "$TAP_TOOL" tap-supported &>/dev/null; then
        _t ERR_TAP_UNSUPPORTED "$TAP_TOOL"
        exit 1
    fi
    # 授权自检由 meetap setup 负责（探测 + 引导 + 盖章）。start 只尊重结果：
    # 若尚未确认过授权（无持久标记），录制前提醒跑一次 setup，但不探测、不播音、
    # 不阻断——避免每次开录都做 2 秒实测 / 播提示音，保持 start 的轻量与静默。
    [[ -f "$TAP_AUTH_MARKER" ]] || _t START_TAP_UNVERIFIED "$0"

    # 会话目录 + 录音文件名
    local session_base
    session_base="$(date +"%Y%m%d_%H%M")"
    if [[ -n "$MEETING_NAME" ]]; then
        session_base="${session_base}_$(sanitize_title "$MEETING_NAME")"
    fi
    SESSION_DIR="$RECORDING_DIR/$session_base"
    # materials/: 存放外部会议资料（议程/PPT导出/背景文档等，支持
    # md/txt/pdf/docx/html），生成纪要时喂给 LLM 辅助 transcript
    mkdir -p "$SESSION_DIR/materials"
    echo "$SESSION_DIR" > "$STATE_DIR/session-dir"
    TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
    OUTPUT_FILE="$SESSION_DIR/meeting_${TIMESTAMP}.m4a"
    echo "$OUTPUT_FILE" > "$OUTPUT_FILE_MARKER"

    # 会议时长上限（可选）：换算成 deadline 的 epoch 秒，交由 autostop_daemon 监控
    if [[ -n "$MAX_DURATION_MIN" ]]; then
        echo $(( $(date +%s) + MAX_DURATION_MIN * 60 )) > "$MAX_DURATION_FILE"
    fi

    # 不切设备，用户照常从原来的扬声器 / 耳机听到声音
    # 采样率：由这里定、同一个值同时传给 audio-tap --output-rate 和 ffmpeg -ar。
    # audio-tap 把 tap、麦克风各自重采样到该率再混音，与设备实际采样率无关。
    # 不再开录前探测 tap 采样率：蓝牙耳机一开麦就切通话模式（输出 48k→24k、
    # 麦克风 24k），探测时与录制时的设备状态不同，探到的值不可信；而麦克风
    # 与 tap 不同率时不重采样会让整段录音 2 倍速 + 升调（AirPods Pro 实录事故）。
    local TAP_RATE=48000

    ORIG_NAME=$("$TOOL" default-output-name 2>/dev/null || echo "Unknown")
    MIC_NAME=$("$TOOL" default-input-name 2>/dev/null || echo "default")

    # audio-tap tap-start 输出 Float32 LE mono PCM 到 stdout
    # ffmpeg 从 stdin 读系统音 + avfoundation 读麦克风,混录输出
    # 注意1：ffmpeg 的 stdin(pipe:0) 就是 audio-tap 的 PCM 数据管道，
    # 绝不能加 < /dev/null（会覆盖管道 → tap 收 EPIPE 秒退 → 录音全空）。
    # 注意2：avfoundation 自带挂钟时间戳而 pipe 从 0 开始，两路直接 amix
    # 会因时间轴永不对齐而输出 0 字节——必须先 asetpts=PTS-STARTPTS 归零。
    # 注意3：麦克风电平由本 ffmpeg 的 astats 滤镜写 mic-level 文件——
    # 绝不能开第二个 ffmpeg 并发采样 :default（输入设备被抢占会导致
    # 录制输入卡死、SIGINT 失效、录音全丢）。波形/静音检测只读该文件。
    # 用 FIFO 替代匿名管道：tap 与 ffmpeg 分开启动，两个 PID 都记录在案。
    # stop 时显式杀 tap，不再依赖「ffmpeg 退出 → EPIPE → tap 自杀」链条
    # （该链条在 ffmpeg 卡死时断裂，留下孤儿 tap 占住音频链路，
    # 导致下一次录制 ffmpeg 打不开输入 → 恶性循环）。
    # meetily 架构：audio-tap 进程内采系统音(tap) + 麦克风(CoreAudio 输入
    # IO proc)，ring buffer 混音后输出单路 PCM；ffmpeg 只做编码、零设备
    # 访问——彻底消灭 avfoundation 与 tap 的设备竞态（用户环境必现卡死）。
    # 电平双文件由 audio-tap 内部输出（tap-level 系统音 / mic-level 麦克风）。
    # audio-tap 的输出自带时钟：系统没播放、也没麦克风时按时补零，stdout
    # 不断流。所以 --mute-microphone 直接不开麦克风（不传 --with-mic）。
    local TAP_FIFO="$STATE_DIR/tap.fifo"

    # tap+ffmpeg 启动 + 自愈重启：启动后探测 ffmpeg 是否真在收数据（见
    # _tap_audio_flowing），没收到就杀掉重启，最多 3 次；仍失败则明确报错，
    # 绝不留下静默空录。Process Tap 回调偶发不启动的问题由 audio-tap 进程内
    # 的看门狗处理（有声音在放但 tap 没回调就重建 tap），这里管的是
    # audio-tap / ffmpeg 本身没起来。
    local TAP_MAX_TRIES=3
    local tap_try=1
    local tap_ok=false
    while (( tap_try <= TAP_MAX_TRIES )); do
        rm -f "$STATE_DIR/tap-level" "$STATE_DIR/mic-level" "$TAP_FIFO" "$STATE_DIR/ffmpeg.log"
        mkfifo "$TAP_FIFO"

        local mic_args=(--with-mic --mic-level-file "$STATE_DIR/mic-level")
        $MUTE_MIC && mic_args=()
        _jobctl_on
        # --zero-alert-text：有声音在放、tap 交出的却全是零时，audio-tap 弹的通知文案
        # （{apps} 换成在放声音的 App，每个写成「显示名（bundle ID）」，写法和分隔符按当前语言传入；整场都查，零段起止记进 tap.log，stop 时随 audio-tap.log
        # 存进会话）。--zero-alert-ignore：不算「有声音在放」的进程（配置 zero_alert_ignore）
        "$TAP_TOOL" tap-start --output-rate "$TAP_RATE" "${mic_args[@]}" \
            --level-file "$STATE_DIR/tap-level" \
            --zero-alert-text "$(_tn NOTIFY_TAP_ZERO)" \
            --zero-alert-ignore "$CFG_ZERO_ALERT_IGNORE" \
            --zero-alert-app-format "$(_tn TAP_ZERO_APP_FORMAT)" \
            --zero-alert-app-sep "$(_tn TAP_ZERO_APP_SEP)" \
            < /dev/null > "$TAP_FIFO" 2>"$STATE_DIR/tap.log" &
        TAP_PID=$!
        _jobctl_off
        echo $TAP_PID > "$TAP_PID_FILE"
        disown $TAP_PID

        # -y：覆盖已存在的输出文件。会话目录名精确到分钟，同一分钟内重跑
        # start 会撞上同名 m4a；缺 -y 时 ffmpeg 弹交互式 Overwrite?[y/N]，
        # stdin=/dev/null 读到 EOF 判为 N 而秒退 → time= 不推进 → 健康探测
        # 误判「tap 无数据」触发自愈，3 次全撞同一文件 → 假报“反复无数据”。
        _jobctl_on
        ffmpeg -y -f f32le -ar "$TAP_RATE" -ac 1 -i "$TAP_FIFO" \
            -c:a aac -b:a "$CFG_AUDIO_BITRATE" -ac 1 \
            -movflags frag_keyframe+empty_moov \
            "$OUTPUT_FILE" \
            < /dev/null > "$STATE_DIR/ffmpeg.log" 2>&1 &

        FFMPEG_PID=$!
        _jobctl_off
        echo $FFMPEG_PID > "$PID_FILE"
        disown $FFMPEG_PID

        # 健康探测：等最多 ~3s 观察 ffmpeg 是否开始推进 time=（即 tap 真在喂数据）。
        # 正常情况下首帧在 1s 内到达；给足 3s 覆盖设备初始化抖动。
        local waited=0
        while (( waited < 30 )); do
            sleep 0.1
            waited=$((waited + 1))
            kill -0 $FFMPEG_PID 2>/dev/null || break
            if _tap_audio_flowing "$STATE_DIR/ffmpeg.log"; then
                tap_ok=true
                break
            fi
        done
        $tap_ok && break

        # 未流动：杀掉本轮 tap+ffmpeg，清理孤儿后重试
        kill -9 $FFMPEG_PID 2>/dev/null
        kill $TAP_PID 2>/dev/null; sleep 0.3; kill -9 $TAP_PID 2>/dev/null
        pkill -f "audio-tap tap-start" 2>/dev/null
        rm -f "$PID_FILE" "$TAP_PID_FILE"
        if (( tap_try < TAP_MAX_TRIES )); then
            _t TAP_STALL_RETRY "$tap_try" "$TAP_MAX_TRIES"
            sleep 0.5
        fi
        tap_try=$((tap_try + 1))
    done

    if ! $tap_ok; then
        rm -f "$STATE_DIR/tap.fifo" "$STATE_DIR/tap-level" "$STATE_DIR/mic-level"
        rm -f "$OUTPUT_FILE_MARKER" "$STATE_DIR/session-dir"
        # 清理本次未成功录音留下的空 session 目录（只有 0 字节 m4a + 空
        # materials），避免残留误导后续 meetap again / 列表。仅当目录里没有
        # 任何非空文件时才删，绝不误删已有内容。
        rm -f "$OUTPUT_FILE"
        [[ -d "$SESSION_DIR" ]] && rmdir "$SESSION_DIR/materials" "$SESSION_DIR" 2>/dev/null
        _t ERR_TAP_STALL "$0"
        exit 1
    fi

    if kill -0 $FFMPEG_PID 2>/dev/null; then
        # 时长上限自停：仅当 meetap start -d N 指定时长时启动守护，到点自动结束。
        # 无 -d 则不自动结束，需手动 stop（静默自停特性已废止）。
        if [[ -n "$MAX_DURATION_MIN" ]]; then
            _jobctl_on; autostop_daemon < /dev/null &
            AUTOSTOP_PID=$!
            _jobctl_off
            echo $AUTOSTOP_PID > "$AUTOSTOP_PID_FILE"
            disown $AUTOSTOP_PID
        fi

        echo ""
        _t RECORDING_STARTED
        # 故障注入开关开着：醒目提示，免得忘了关、把正式会议录成静音
        [[ -n "${MEETAP_TAP_FAULT_ZERO_AFTER:-}" ]] && _t WARN_FAULT_INJECT "$MEETAP_TAP_FAULT_ZERO_AFTER"
        $VERBOSE && _t FIELD_FILE "$OUTPUT_FILE"
        _t FIELD_PLAYBACK "$ORIG_NAME (Process Tap)"
        $MUTE_MIC && _t FIELD_MIC_MUTED
        if $FOREGROUND; then _t FIELD_STOP_CTRL_C "$0"; else _t FIELD_STOP_CMD "$0"; fi
        if [[ -n "$MAX_DURATION_MIN" ]]; then
            _t FIELD_MAX_DURATION "$MAX_DURATION_MIN" "$(date -v+"${MAX_DURATION_MIN}"M +%H:%M)"
        else
            _t FIELD_STOP_MANUAL
        fi
        echo ""
    else
        _t ERR_FFMPEG_FAIL
        cat "$STATE_DIR/ffmpeg.log"
        exit 1
    fi

    # 走到这里说明录音已成功启动（失败时都已 exit）
    start_sleepwatch
    if $FOREGROUND; then
        foreground_wait
    elif [[ -n "$START_TTY" ]]; then
        # -b 后台模式：保持旧行为，波形在后台画到终端底部
        sleep 0.1
        setup_statusbar "$START_TTY"
        start_visualizer "$START_TTY" &
        echo $! > "$VISUALIZER_PID_FILE"
        disown $!
    fi
}

stop_recording() {
    local VERBOSE=false
    local SLEEP_MODE=false   # 休眠触发：只收尾录音，不转录，留待唤醒后 meetap again
    local arg
    for arg in "$@"; do
        case "$arg" in
            -t|--test) VERBOSE=true ;;
            --sleep)   SLEEP_MODE=true ;;
        esac
    done
    stop_visualizer

    # 停止自动停止守护进程
    if [[ -f "$AUTOSTOP_PID_FILE" ]]; then
        kill "$(cat "$AUTOSTOP_PID_FILE")" 2>/dev/null
        rm -f "$AUTOSTOP_PID_FILE" "$MEETING_APPS_FILE"
    fi
    rm -f "$MAX_DURATION_FILE"

    # 休眠监听：普通 stop 一并结束；--sleep 是 sleep-watch 自己调的，它要活到唤醒发通知
    $SLEEP_MODE || _kill_sleepwatch

    # 没有 ffmpeg PID 也可能有残留要收拾：start 启动阶段被 Ctrl-C 打断时，
    # tap 已起，但 ffmpeg 还没写 PID
    if [[ ! -f "$PID_FILE" && ! -f "$TAP_PID_FILE" ]]; then
        _t ERR_NO_ACTIVE_RECORDING
        exit 1
    fi

    # 停止 ffmpeg
    if [[ -f "$PID_FILE" ]]; then
        FFMPEG_PID=$(cat "$PID_FILE")
        if kill -0 "$FFMPEG_PID" 2>/dev/null; then
            kill -INT "$FFMPEG_PID"
            _t WAITING_RECORDING
            for i in $(seq 1 15); do
                kill -0 "$FFMPEG_PID" 2>/dev/null || break
                sleep 1
            done
            # 如果 15 秒后仍未退出，强制终止
            if kill -0 "$FFMPEG_PID" 2>/dev/null; then
                _t FFMPEG_FORCE_KILL
                kill -9 "$FFMPEG_PID" 2>/dev/null
                sleep 1
            fi
        fi
        rm -f "$PID_FILE"
    fi

    # 显式停止 audio-tap（不再依赖 EPIPE 自杀——ffmpeg 卡死时该链条会断）
    if [[ -f "$TAP_PID_FILE" ]]; then
        TAP_PID=$(cat "$TAP_PID_FILE")
        kill "$TAP_PID" 2>/dev/null
        sleep 0.5
        kill -9 "$TAP_PID" 2>/dev/null
        rm -f "$TAP_PID_FILE"
    fi
    # 兜底清扫任何孤儿 tap（异常路径可能没写 PID 文件）
    pkill -f "audio-tap tap-start" 2>/dev/null

    # 清理 tap/mic 电平文件与 FIFO
    rm -f "$STATE_DIR/tap-level" "$STATE_DIR/tap-level.tmp" "$STATE_DIR/mic-level" "$STATE_DIR/tap.fifo"

    # 显示文件信息
    if [[ -f "$OUTPUT_FILE_MARKER" ]]; then
        OUTPUT_FILE=$(cat "$OUTPUT_FILE_MARKER")
        rm -f "$OUTPUT_FILE_MARKER"
        if [[ -f "$OUTPUT_FILE" ]]; then
            FILE_SIZE=$(du -h "$OUTPUT_FILE" | cut -f1)
            DURATION=$(ffprobe -v quiet -show_entries format=duration \
                -of csv=p=0 "$OUTPUT_FILE" 2>/dev/null \
                | xargs printf "%.0f" 2>/dev/null)
            if [[ -n "$DURATION" && "$DURATION" -gt 0 ]]; then
                MINS=$((DURATION / 60))
                SECS=$((DURATION % 60))
                if $VERBOSE; then
                    _t RECORDING_SAVED
                    _t FIELD_FILE "$OUTPUT_FILE"
                    _t FIELD_SIZE "$FILE_SIZE"
                    _t FIELD_DURATION "$MINS" "$SECS"
                else
                    _t RECORDING_SUCCESS
                fi
            else
                if $VERBOSE; then
                    _t RECORDING_SAVED
                    _t FIELD_FILE "$OUTPUT_FILE"
                    _t FIELD_SIZE "$FILE_SIZE"
                else
                    _t RECORDING_SUCCESS
                fi
            fi
        fi
    fi

    # 清理空的会话目录，或启动后台转录
    if [[ -f "$STATE_DIR/session-dir" ]]; then
        SESSION_DIR=$(cat "$STATE_DIR/session-dir")
        if [[ -d "$SESSION_DIR" ]] && [ -z "$(ls -A "$SESSION_DIR")" ]; then
            rm -f "$STATE_DIR/session-dir"
            rmdir "$SESSION_DIR"
            _t EMPTY_SESSION_REMOVED "$SESSION_DIR"
        elif [[ -n "$OUTPUT_FILE" && -f "$OUTPUT_FILE" ]]; then
            # 留存 audio-tap 诊断日志（设备采样率、重采样、时钟自检）：/tmp 下的
            # tap.log 每次开录都会被覆盖，事后排查录音变速/静音全靠这份副本
            if [[ -s "$STATE_DIR/tap.log" ]]; then
                mkdir -p "$SESSION_DIR/log" && cp "$STATE_DIR/tap.log" "$SESSION_DIR/log/audio-tap.log"
                grep -q "CLOCK_DRIFT" "$STATE_DIR/tap.log" && _t REC_CLOCK_DRIFT "$SESSION_DIR/log/audio-tap.log"
            fi
            if $SLEEP_MODE; then
                # 马上要休眠，上传会被打断：只记下会话，唤醒后提示 meetap again。
                # 先写待办再删 session-dir：保证「session-dir 消失」⇒ 待办已写入
                basename "$SESSION_DIR" > "$PENDING_AGAIN_FILE"
                rm -f "$STATE_DIR/session-dir"
            else
                rm -f "$STATE_DIR/session-dir"
                _t TRANSCRIBE_BACKGROUND
                # 忽略 HUP：关闭终端窗口触发的 stop 之后，转录不能被连带杀死
                # （transcribe_recording 是函数，nohup 包不了，只能在子 shell 里 trap）
                ( trap '' HUP; transcribe_recording "$OUTPUT_FILE" "$SESSION_DIR" ) < /dev/null &
                disown
            fi
        else
            rm -f "$STATE_DIR/session-dir"
        fi
    fi
}

# 唤醒通知（内部子命令，由 sleep-watch 在唤醒后调用）：提示用 again 补跑转录与纪要。
# 通知里写具体会话名——again 不带参数取最新会话，唤醒后若先开了新会议会选错。
wake_notify() {
    rm -f "$SLEEPWATCH_PID_FILE"   # sleep-watch 发完通知即退出，PID 文件不再有效
    [[ -f "$PENDING_AGAIN_FILE" ]] || return 0
    local session
    session=$(cat "$PENDING_AGAIN_FILE")
    osascript -e "display notification \"$(_tn NOTIFY_SLEEP_STOPPED "$session")\" with title \"MeeTap\"" 2>/dev/null
    return 0
}

show_status() {
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        local start_time
        start_time=$(stat -f %m "$PID_FILE" 2>/dev/null)
        local elapsed=""
        if [[ -n "$start_time" ]]; then
            local secs=$(( $(date +%s) - start_time ))
            elapsed=$(printf " (%02d:%02d)" $((secs/60)) $((secs%60)))
        fi
        # 逐行收集状态信息，最后用 ui_card 统一渲染（无 gum 时逐行原样打印）
        local status_lines=()
        status_lines+=("$(_tn STATUS_RECORDING "$elapsed")")
        [[ -f "$OUTPUT_FILE_MARKER" ]] && status_lines+=("$(_tn STATUS_FILE "$(cat "$OUTPUT_FILE_MARKER")")")
        if [[ -f "$AUTOSTOP_PID_FILE" ]] && kill -0 "$(cat "$AUTOSTOP_PID_FILE")" 2>/dev/null; then
            status_lines+=("$(_tn STATUS_AUTOSTOP_ON)")
        fi
        if [[ -f "$VISUALIZER_PID_FILE" ]] && kill -0 "$(cat "$VISUALIZER_PID_FILE")" 2>/dev/null; then
            status_lines+=("$(_tn STATUS_VISUALIZER_RUN)")
        fi
        ui_card "${status_lines[@]}"
    else
        local idle_lines=("$(_tn STATUS_IDLE)")
        [[ -f "$PENDING_AGAIN_FILE" ]] && \
            idle_lines+=("$(_tn STATUS_PENDING_AGAIN "$0" "$(cat "$PENDING_AGAIN_FILE")")")
        ui_card "${idle_lines[@]}"
        rm -f "$PID_FILE"
    fi
}

# 写入授权已通过的持久标记（顺带保证配置目录存在，覆盖模板缺失等边缘情况）。
mark_tap_authorized() {
    mkdir -p "$(dirname "$TAP_AUTH_MARKER")" 2>/dev/null
    touch "$TAP_AUTH_MARKER" 2>/dev/null
}

# Process Tap 静音自测：后台播提示音，tap 录 2 秒，检查捕获是否全零。
# 返回 0=有信号（授权正常），1=全静音（宿主终端缺系统录音授权）。
# 顶层函数，供 setup（授权引导）与 start（首次惰性自检）共用。
# 参数：$1 = audio-tap 工具路径。
tap_probe() {
    local tap_tool="$1"
    mkdir -p "$STATE_DIR"
    local pcm="$STATE_DIR/tap-probe.pcm"
    ( sleep 0.6 && afplay /System/Library/Sounds/Glass.aiff ) &>/dev/null &
    "$tap_tool" tap-start --duration 2 > "$pcm" 2>/dev/null
    # 全零检测：删除所有 0x00 后剩余字节数 >0 即有信号。
    # 不能用 head -c1|grep .（首个非零字节若是 0x0A 换行会被 grep 误判为空）
    [[ "$(LC_ALL=C tr -d '\0' < "$pcm" | wc -c)" -gt 0 ]] && return 0
    return 1
}

# 全零 → 引导用户在系统设置里为终端 App 添加系统录音授权，并复测一次。
# macOS 的 TCC 对系统音频捕获有个陷阱：宿主终端 App（如 Ghostty）若未声明
# NSAudioCaptureUsageDescription，授权框永远不弹、tap 静默输出全零——用户毫无感知。
# 返回 0=复测通过，1=仍静音。参数：$1 = audio-tap 工具路径。
tap_authorize_guide() {
    local tap_tool="$1"
    echo ""
    _t SETUP_TAP_SILENT_HEADER
    _t SETUP_TAP_SILENT_WHY
    _t SETUP_TAP_GUIDE_1
    _t SETUP_TAP_GUIDE_2
    _t SETUP_TAP_GUIDE_3
    echo ""
    # 直接打开系统设置对应面板，减少用户找入口的成本
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AudioCapture" 2>/dev/null
    ui_pause "$(_tn SETUP_TAP_PRESS_AFTER_GRANT)"

    # 复测（授权改动可能要求重启终端才生效，复测失败时如实告知）
    _t SETUP_TAP_PROBING
    if tap_probe "$tap_tool"; then
        _t SETUP_TAP_OK
        return 0
    fi
    _t SETUP_TAP_STILL_SILENT
    return 1
}

# setup 中的 Process Tap 授权检测与引导。
# 返回 0=Tap 可用（授权已通过），1=不可用（不支持或授权失败）。
# 通过时写持久标记 TAP_AUTH_MARKER，让后续 meetap start 直接信任、跳过自测。
setup_tap() {
    local TAP_TOOL="$SCRIPT_DIR/audio-tap"

    if [[ ! -x "$TAP_TOOL" ]] || ! "$TAP_TOOL" tap-supported &>/dev/null; then
        _t SETUP_TAP_UNSUPPORTED
        rm -f "$TAP_AUTH_MARKER"
        return 1
    fi

    _t SETUP_TAP_PROBING
    if tap_probe "$TAP_TOOL"; then
        _t SETUP_TAP_OK
        mark_tap_authorized
        return 0
    fi

    if tap_authorize_guide "$TAP_TOOL"; then
        mark_tap_authorized
        return 0
    fi

    # 授权真失败：清除标记，触发下次重新引导
    rm -f "$TAP_AUTH_MARKER"
    _t SETUP_TAP_FALLBACK_NOTE
    return 1
}

# 当前终端 App 的名字（权限是授给它的）：TERM_PROGRAM 认得出的写名字，认不出写「你的终端 App」
_terminal_app_name() {
    case "${TERM_PROGRAM:-}" in
        Apple_Terminal) _tn TERMINAL_APPLE ;;
        ghostty)        printf 'Ghostty' ;;
        iTerm.app)      printf 'iTerm' ;;
        WarpTerminal)   printf 'Warp' ;;
        vscode)         printf 'Visual Studio Code' ;;
        "")             _tn TERMINAL_UNKNOWN ;;
        *)              printf '%s' "$TERM_PROGRAM" ;;
    esac
}

# setup：日历授权（可选）。整个 meetap 只有这里会请求日历授权（会弹授权框）；
# 开录、停止、休眠自动停止、后台录音都只在已经授权时读。拒绝、跳过都算通过。
setup_calendar() {
    local st term
    if [[ "$CFG_CALENDAR" != "on" ]]; then
        _t SETUP_CAL_OFF
        return 0
    fi
    if [[ ! -x "$TOOL" ]]; then
        _t SETUP_CAL_UNAVAILABLE "$TOOL"
        return 0
    fi
    term=$(_terminal_app_name)
    st=$("$TOOL" calendar-status 2>/dev/null)
    if [[ "$st" == notDetermined || "$st" == writeOnly ]]; then
        if [[ -t 0 ]]; then
            if [[ "$st" == writeOnly ]]; then _t SETUP_CAL_UPGRADE_ASK; else _t SETUP_CAL_ASK; fi
            st=$("$TOOL" calendar-request 2>/dev/null)
        elif [[ "$st" == notDetermined ]]; then
            _t SETUP_CAL_NO_TTY
            return 0
        fi
    fi
    case "$st" in
        fullAccess)
            local n
            n=$("$TOOL" calendar-count 2>/dev/null)
            if [[ "$n" =~ ^[0-9]+$ && "$n" -gt 0 ]]; then _t SETUP_CAL_OK "$n"; else _t SETUP_CAL_NO_CALENDARS; fi
            ;;
        writeOnly)          _t SETUP_CAL_WRITE_ONLY "$term" "$term" ;;
        denied|restricted)  _t SETUP_CAL_DENIED "$term" "$term" ;;
        *)                  _t SETUP_CAL_UNKNOWN "${st:-?}" ;;
    esac
    return 0
}

setup_apps() {
    _require_macos || exit 1
    _t SETUP_HEADER
    _t SETUP_TITLE
    _t SETUP_HEADER
    echo ""

    # 2.0 升级迁移检查：放在授权自检之前——自检会往默认输出放提示音，
    # 输出还停在 BlackHole 上的话用户听不见。录音进行中不动输出设备。
    _t SETUP_STEP_MIGRATE
    _t SETUP_DIVIDER
    if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        _t SETUP_MIGRATE_SKIP_RECORDING
    else
        _migrate_output_device
    fi
    _check_meeting_apps
    _t SETUP_MIGRATE_DONE
    echo ""

    _warn_old_capture_config
    _t SETUP_STEP_TAP
    _t SETUP_DIVIDER
    setup_tap
    echo ""

    _t SETUP_STEP_CALENDAR
    _t SETUP_DIVIDER
    setup_calendar
    echo ""

    _t SETUP_HEADER
    _t SETUP_ALL_DONE "$0"
    _t SETUP_ALL_DONE_HINT
    _t SETUP_HEADER
}

show_usage() {
    _t USAGE_HEADER "$VERSION"
    echo ""
    _t USAGE_LINE
    echo ""
    _t USAGE_BARE
    _t USAGE_START
    _t USAGE_STOP
    _t USAGE_STATUS
    _t USAGE_AGAIN
    _t USAGE_HIGHLIGHT
    _t USAGE_TAG
    _t USAGE_TAG_SESSION
    _t USAGE_TAG_LIST
    _t USAGE_UNTAG
    _t USAGE_INFO
    _t USAGE_SETUP
    _t USAGE_CONFIG
    _t USAGE_CONFIG_SHOW
    _t USAGE_VERSION
    _t USAGE_HELP
    echo ""
    _t USAGE_HINT
}

case "${1:-}" in
    start)
        start_recording "${@:2}"
        ;;
    stop)
        stop_recording "${@:2}"
        ;;
    status)
        show_status
        ;;
    again)
        again_session "${2:-}" "${3:-}"
        ;;
    _wake-notify)
        wake_notify
        ;;
    _calendar-lookup)
        # 内部：meetap _calendar-lookup <会话目录> [<开始 epoch> <结束 epoch>]（测试、排查用）
        if [[ -n "${3:-}" ]]; then calendar_lookup "${2:-}" "$3" "${4:-$3}"; else calendar_lookup_for_session "${2:-}"; fi
        ;;
    mark)
        highlight_notes "${2:-}"
        ;;
    setup)
        setup_apps
        ;;
    setup-zoom|setup-teams|setup-wemeet)
        # 1.x 时代给 BlackHole 配会议 App 扬声器的命令，2.0 起不需要了
        _t SETUP_APPS_NOT_NEEDED
        ;;
    config)
        case "${2:-edit}" in
            show)
                _t CONFIG_HEADER "$VERSION"
                _t CONFIG_SEPARATOR
                if [[ -f "$CONFIG_FILE" ]]; then
                    _t CONFIG_FILE_PATH "$CONFIG_FILE"
                else
                    _t CONFIG_FILE_NONE
                fi
                echo ""
                # 配置列表用 ui_card 渲染（无 gum 时逐行原样打印，内容不变）
                ui_card \
                    "  region                = $CFG_REGION" \
                    "  language              = $CFG_LANGUAGE" \
                    "  ai_backend            = $CFG_AI_BACKEND" \
                    "  model                 = $CFG_MODEL" \
                    "  transcribe_languages  = $CFG_TRANSCRIBE_LANGUAGES" \
                    "  recording_dir         = $CFG_RECORDING_DIR" \
                    "  max_speakers          = $CFG_MAX_SPEAKERS" \
                    "  audio_bitrate         = $CFG_AUDIO_BITRATE" \
                    "  audio_persist         = $CFG_AUDIO_PERSIST" \
                    "  multi_language        = $CFG_MULTI_LANGUAGE" \
                    "  visualizer            = $CFG_VISUALIZER" \
                    "  zero_alert_ignore     = ${CFG_ZERO_ALERT_IGNORE:-<none>}" \
                    "  calendar              = $CFG_CALENDAR" \
                    "  email                 = ${CFG_EMAIL:-<not set>}" \
                    "  email_sender          = ${CFG_EMAIL_SENDER:-<not set>}"
                echo ""
                [[ -f "$CONFIG_FILE" ]] && _t CONFIG_RESET_HINT "$CONFIG_FILE"
                ;;
            edit|"")
                # ensure_config already created the file at startup if possible;
                # if it's still missing (no template found), try once more or bail.
                if [[ ! -f "$CONFIG_FILE" ]]; then
                    ensure_config
                    [[ -f "$CONFIG_FILE" ]] || {
                        _t CONFIG_NO_TEMPLATE
                        exit 1
                    }
                fi
                MEETAP_EDITOR="${VISUAL:-${EDITOR:-vi}}"
                _t CONFIG_OPENING_EDITOR "$MEETAP_EDITOR"
                exec "$MEETAP_EDITOR" "$CONFIG_FILE"
                ;;
            *)
                echo "Usage: meetap config [edit|show]" >&2
                exit 1
                ;;
        esac
        ;;
    -v|--version|version)
        _t VERSION_LINE "$VERSION${BUILD_ID:+ ($BUILD_ID)}"
        ;;
    "")
        # 只敲 meetap ≡ meetap start。只认「完全不带参数」：meetap 周会、拼错的子命令
        # 都不会落到这里，免得敲错一个字就开录。
        start_recording
        ;;
    help|-h|--help)
        show_usage
        ;;
    -t|--test|-d|--duration|-b|--background|-m|--mute-mic|--mute-microphone)
        # 开录选项开头 ≡ meetap start …（白名单，不是「减号开头就开录」）。
        # 和贴标签混用一律报错不开录：想贴标签却开了录，比报错代价大得多。
        for _arg in "$@"; do
            case "$_arg" in
                -g|--tag|--untag)
                    _t ERR_TAG_WITH_START_OPT "$(basename "$0")" "$(basename "$0")"
                    exit 1
                    ;;
            esac
        done
        start_recording "$@"
        ;;
    -g|--tag|--untag)
        session_cmd "" "$@"
        ;;
    *)
        # meetap <会话> [-g 标签 | --untag 标签 | -g]：名字或路径都行，但目录名必须是会话名；
        # meetap 周会、meetap .、meetap src 这类按不认识的命令处理
        if _sd=$(resolve_session "$1" strict); then
            session_cmd "$_sd" "${@:2}"
        elif _looks_like_session "$1"; then
            _t ERR_SESSION_NOT_FOUND "$1" "$RECORDING_DIR"
            exit 1
        else
            _t ERR_UNKNOWN_COMMAND "$1"
            echo ""
            show_usage
            exit 1
        fi
        ;;
esac
